{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "producer-crypto-use-proof.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publishable",
    "failureKind",
    "authorizationDigest",
    "prerequisiteReadbackDigest",
    "issuer",
    "issuedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "producer-crypto-use-proof.v2"
    },
    "publishable": {
      "type": "boolean"
    },
    "failureKind": {
      "anyOf": [
        {
          "enum": ["FAILED", "INTERRUPTED_UNKNOWN"]
        },
        {
          "type": "null"
        }
      ]
    },
    "authorizationDigest": {
      "$ref": "#/$defs/digest"
    },
    "prerequisiteReadbackDigest": {
      "$ref": "#/$defs/digest"
    },
    "dataObservationDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/successRequest"
        },
        {
          "$ref": "#/$defs/failureRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/successExecution"
        },
        {
          "$ref": "#/$defs/failureExecution"
        },
        {
          "type": "null"
        }
      ]
    },
    "encryption": {
      "anyOf": [
        {
          "$ref": "#/$defs/encryption"
        },
        {
          "type": "null"
        }
      ]
    },
    "cleanup": {
      "anyOf": [
        {
          "$ref": "#/$defs/successCleanup"
        },
        {
          "$ref": "#/$defs/failureCleanup"
        },
        {
          "type": "null"
        }
      ]
    },
    "issuer": {
      "$ref": "#/$defs/id"
    },
    "issuedAt": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["dataObservationDigest", "request", "execution", "encryption", "cleanup"],
      "properties": {
        "publishable": {
          "const": true
        },
        "failureKind": {
          "type": "null"
        },
        "dataObservationDigest": {
          "$ref": "#/$defs/digest"
        },
        "request": {
          "$ref": "#/$defs/successRequest"
        },
        "execution": {
          "$ref": "#/$defs/successExecution"
        },
        "encryption": {
          "$ref": "#/$defs/encryption"
        },
        "cleanup": {
          "$ref": "#/$defs/successCleanup"
        }
      }
    },
    {
      "type": "object",
      "not": {
        "$ref": "#/$defs/completeSuccessFacts"
      },
      "properties": {
        "publishable": {
          "const": false
        },
        "failureKind": {
          "const": "FAILED"
        },
        "dataObservationDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/failureRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/failureExecution"
            },
            {
              "type": "null"
            }
          ]
        },
        "encryption": {
          "anyOf": [
            {
              "$ref": "#/$defs/encryption"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup": {
          "anyOf": [
            {
              "$ref": "#/$defs/failureCleanup"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "not": {
        "$ref": "#/$defs/completeSuccessFacts"
      },
      "properties": {
        "publishable": {
          "const": false
        },
        "failureKind": {
          "const": "INTERRUPTED_UNKNOWN"
        },
        "dataObservationDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/failureRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/failureExecution"
            },
            {
              "type": "null"
            }
          ]
        },
        "encryption": {
          "anyOf": [
            {
              "$ref": "#/$defs/encryption"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup": {
          "anyOf": [
            {
              "$ref": "#/$defs/failureCleanup"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "rfc3339Finite": true
    },
    "successRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "action",
        "keySpec",
        "keyFingerprint",
        "contextDigest",
        "callCount",
        "outcome"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/id"
        },
        "action": {
          "const": "local:GenerateAndWrapDataKey"
        },
        "keySpec": {
          "const": "AES_256"
        },
        "keyFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "contextDigest": {
          "$ref": "#/$defs/digest"
        },
        "callCount": {
          "const": 1
        },
        "outcome": {
          "const": "SUCCESS"
        }
      }
    },
    "failureRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "action",
        "keySpec",
        "keyFingerprint",
        "contextDigest",
        "callCount",
        "outcome"
      ],
      "properties": {
        "requestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "const": "local:GenerateAndWrapDataKey"
        },
        "keySpec": {
          "const": "AES_256"
        },
        "keyFingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "contextDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "callCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": ["SUCCESS", "FAILED", "INTERRUPTED_UNKNOWN"]
        }
      }
    },
    "successExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "issuedAt",
        "expiresAt",
        "terminalState",
        "terminalAt",
        "terminalReceiptDigest",
        "processExitCode",
        "processSignal",
        "processExitRecordDigest"
      ],
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "issuedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "terminalState": {
          "enum": ["ADMISSION_CLOSED", "ADMISSION_EXPIRED"]
        },
        "terminalAt": {
          "$ref": "#/$defs/timestamp"
        },
        "terminalReceiptDigest": {
          "$ref": "#/$defs/digest"
        },
        "processExitCode": {
          "const": 0
        },
        "processSignal": {
          "type": "null"
        },
        "processExitRecordDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "failureExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "issuedAt",
        "expiresAt",
        "terminalState",
        "terminalAt",
        "terminalReceiptDigest",
        "processExitCode",
        "processSignal",
        "processExitRecordDigest"
      ],
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminalState": {
          "enum": ["ADMISSION_CLOSED", "ADMISSION_EXPIRED", "ACTIVE", "UNKNOWN"]
        },
        "terminalAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminalReceiptDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "processExitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "processSignal": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^SIG[A-Z0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "processExitRecordDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelopeDigest", "ciphertextDigest", "wrappedDekDigest"],
      "properties": {
        "envelopeDigest": {
          "$ref": "#/$defs/digest"
        },
        "ciphertextDigest": {
          "$ref": "#/$defs/digest"
        },
        "wrappedDekDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "successCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreDumpDisabled", "memoryLocked", "keyBufferClear", "processExitedAt"],
      "anyOf": [
        {
          "properties": {
            "memoryLocked": {
              "const": true
            }
          }
        },
        {
          "required": ["hostSwapDisabled"],
          "properties": {
            "memoryLocked": {
              "const": false
            },
            "hostSwapDisabled": {
              "const": true
            }
          }
        }
      ],
      "properties": {
        "coreDumpDisabled": {
          "const": true
        },
        "memoryLocked": {
          "type": "boolean"
        },
        "hostSwapDisabled": {
          "type": "boolean"
        },
        "keyBufferClear": {
          "const": "BEST_EFFORT_COMPLETED"
        },
        "processExitedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "failureCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreDumpDisabled", "memoryLocked", "keyBufferClear", "processExitedAt"],
      "properties": {
        "coreDumpDisabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryLocked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "hostSwapDisabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "keyBufferClear": {
          "anyOf": [
            {
              "enum": ["BEST_EFFORT_COMPLETED", "FAILED", "UNKNOWN"]
            },
            {
              "type": "null"
            }
          ]
        },
        "processExitedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "completeSuccessFacts": {
      "type": "object",
      "required": ["dataObservationDigest", "request", "execution", "encryption", "cleanup"],
      "properties": {
        "dataObservationDigest": {
          "$ref": "#/$defs/digest"
        },
        "request": {
          "$ref": "#/$defs/successRequest"
        },
        "execution": {
          "$ref": "#/$defs/successExecution"
        },
        "encryption": {
          "$ref": "#/$defs/encryption"
        },
        "cleanup": {
          "$ref": "#/$defs/successCleanup"
        }
      }
    }
  }
}
