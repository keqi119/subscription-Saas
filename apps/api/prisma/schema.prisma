  currentForOrder   SubscriptionOrder? @relation("OrderContract")
  customerId        String             @map("customer_id") @db.Uuid
  customer          Customer           @relation(fields: [customerId], references: [id])
  businessType      BusinessType       @default(SUBSCRIPTION) @map("business_type")
  contractVersionId String             @map("contract_version_id") @db.Uuid
  contractVersion   ContractVersion    @relation(fields: [contractVersionId], references: [id])
  contractTitle     String             @map("contract_title") @db.VarChar(128)
  contractSnapshot  Json               @map("contract_snapshot")
  status            ContractStatus     @default(GENERATED)
  signedAt          DateTime?          @map("signed_at") @db.Timestamptz(6)
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(6)
  fileId            String?            @map("file_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?            @map("created_by") @db.Uuid
  updatedBy         String?            @map("updated_by") @db.Uuid
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([customerId])
  @@index([businessType])
  @@index([contractVersionId])
  @@index([status])
  @@map("contract")
}

model OrderChange {
  id             String            @id @default(uuid()) @db.Uuid
  orderId        String            @map("order_id") @db.Uuid
  order          SubscriptionOrder @relation(fields: [orderId], references: [id])
  changeType     OrderChangeType   @map("change_type")
  beforeSnapshot Json?             @map("before_snapshot")
  afterSnapshot  Json?             @map("after_snapshot")
  reason         String            @db.Text
  status         OrderChangeStatus @default(PENDING)
  approvedBy     String?           @map("approved_by") @db.Uuid
  approver       User?             @relation("OrderChangeApprover", fields: [approvedBy], references: [id])
  approvedAt     DateTime?         @map("approved_at") @db.Timestamptz(6)
  executedAt     DateTime?         @map("executed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?           @map("created_by") @db.Uuid
  updatedBy      String?           @map("updated_by") @db.Uuid
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([changeType])
  @@index([status])
  @@index([approvedBy])
  @@map("order_change")
}

model FileObject {
  id            String                    @id @default(uuid()) @db.Uuid
  bucket        String                    @db.VarChar(64)
  objectKey     String                    @map("object_key") @db.VarChar(255)
  originalName  String                    @map("original_name") @db.VarChar(255)
  mimeType      String?                   @map("mime_type") @db.VarChar(128)
  sizeBytes     BigInt                    @map("size_bytes")
  uploadedBy    String?                   @map("uploaded_by") @db.Uuid
  uploader      User?                     @relation("FileUploader", fields: [uploadedBy], references: [id])
  materials     ApplicationMaterial[]
  materialFiles ApplicationMaterialFile[]
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([bucket])
  @@index([uploadedBy])
  @@map("file_object")
}
