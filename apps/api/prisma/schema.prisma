model User {
  id                       String                     @id @default(uuid()) @db.Uuid
  username                 String                     @unique @db.VarChar(64)
  name                     String                     @db.VarChar(64)
  mobile                   String?                    @db.VarChar(32)
  email                    String?                    @unique @db.VarChar(128)
  passwordHash             String                     @map("password_hash") @db.VarChar(255)
  status                   UserStatus                 @default(ACTIVE)
  lastLoginAt              DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                String?                    @map("created_by") @db.Uuid
  updatedBy                String?                    @map("updated_by") @db.Uuid
  deletedAt                DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  roles                    UserRole[]
  customers                Customer[]                 @relation("CustomerOwner")
  applications             Application[]              @relation("ApplicationSales")
  uploadedFiles            FileObject[]               @relation("FileUploader")
  followups                CustomerFollowup[]         @relation("FollowupUser")
  riskResults              RiskResult[]               @relation("RiskResultApprover")
  reviewedMaterials        ApplicationMaterial[]      @relation("MaterialReviewer")
  reviewedMaterialGroups   ApplicationMaterialGroup[] @relation("MaterialGroupReviewer")
  uploadedMaterialFiles    ApplicationMaterialFile[]  @relation("MaterialFileUploader")
  deletedMaterialFiles     ApplicationMaterialFile[]  @relation("MaterialFileDeleter")
  applicationActionLogs    ApplicationActionLog[]     @relation("ApplicationActionOperator")
  approvedProductVersions  ProductVersion[]           @relation("ProductVersionApprover")
  confirmedQuotes          SubscriptionQuote[]        @relation("QuoteConfirmer")
  approvedContractVersions ContractVersion[]          @relation("ContractVersionApprover")
  approvedOrderChanges     OrderChange[]              @relation("OrderChangeApprover")

  @@index([status])
  @@map("user")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  name        String           @db.VarChar(64)
  description String?          @db.Text
  status      RecordStatus     @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]
  menus       RoleMenu[]

  @@index([status])
  @@map("role")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(128)
  name        String           @db.VarChar(128)
  module      String           @db.VarChar(64)
  action      String           @db.VarChar(64)
  description String?          @db.Text
  status      RecordStatus     @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@index([module])
  @@index([status])
  @@map("permission")
}

model Menu {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique @db.VarChar(128)
  name           String       @db.VarChar(128)
  path           String       @db.VarChar(255)
  icon           String?      @db.VarChar(64)
  sortOrder      Int          @default(0) @map("sort_order")
  permissionCode String?      @map("permission_code") @db.VarChar(128)
  parentId       String?      @map("parent_id") @db.Uuid
  parent         Menu?        @relation("MenuTree", fields: [parentId], references: [id])
  children       Menu[]       @relation("MenuTree")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  roles          RoleMenu[]

  @@index([parentId])
  @@index([status])
  @@map("menu")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model RoleMenu {
  id        String    @id @default(uuid()) @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  menuId    String    @map("menu_id") @db.Uuid
  role      Role      @relation(fields: [roleId], references: [id])
  menu      Menu      @relation(fields: [menuId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([roleId, menuId])
  @@index([menuId])
  @@map("role_menu")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  module         String      @db.VarChar(64)
  entityType     String      @map("entity_type") @db.VarChar(64)
  entityId       String?     @map("entity_id") @db.Uuid
  action         AuditAction
  beforeSnapshot Json?       @map("before_snapshot")
  afterSnapshot  Json?       @map("after_snapshot")
  operatorId     String?     @map("operator_id") @db.Uuid
  ipAddress      String?     @map("ip_address") @db.VarChar(64)
  userAgent      String?     @map("user_agent") @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([module])
  @@index([entityType, entityId])
  @@index([operatorId])
  @@index([createdAt])
  @@map("audit_log")
}

model Customer {
  id               String              @id @default(uuid()) @db.Uuid
  customerNo       String              @unique @map("customer_no") @db.VarChar(64)
  name             String              @db.VarChar(64)
  mobile           String              @db.VarChar(32)
  customerType     CustomerType        @default(PERSONAL) @map("customer_type")
  sourceChannel    String?             @map("source_channel") @db.VarChar(64)
  grade            CustomerGrade?
  riskScore        Int?                @map("risk_score")
  status           CustomerStatus      @default(LEAD)
  ownerUserId      String?             @map("owner_user_id") @db.Uuid
  ownerUser        User?               @relation("CustomerOwner", fields: [ownerUserId], references: [id])
  remark           String?             @db.Text
  identity         CustomerIdentity?
  profile          CustomerProfile?
  followups        CustomerFollowup[]
  applications     Application[]
  riskResults      RiskResult[]
  quotes           SubscriptionQuote[]
  orders           SubscriptionOrder[]
  contracts        Contract[]
  deliveries       VehicleDelivery[]
  returns          VehicleReturn[]
  receivableBills  ReceivableBill[]
  paymentRecords   PaymentRecord[]
  paymentWriteOffs PaymentWriteOff[]
  depositLedgers   DepositLedger[]
  collectionCases   CollectionCase[]
  collectionCaseBills CollectionCaseBill[]
  collectionActions CollectionAction[]
  entitlementAccounts OrderEntitlementAccount[]
  entitlementGrants   OrderEntitlementGrant[]
  entitlementUsages   OrderEntitlementUsage[]
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?             @map("created_by") @db.Uuid
  updatedBy        String?             @map("updated_by") @db.Uuid
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)

  @@index([mobile])
  @@index([ownerUserId])
  @@index([status])
  @@map("customer")
}

model CustomerIdentity {
  id                  String    @id @default(uuid()) @db.Uuid
  customerId          String    @unique @map("customer_id") @db.Uuid
  customer            Customer  @relation(fields: [customerId], references: [id])
  idCardNo            String?   @map("id_card_no") @db.VarChar(32)
  idCardFrontFileId   String?   @map("id_card_front_file_id") @db.Uuid
  idCardBackFileId    String?   @map("id_card_back_file_id") @db.Uuid
  driverLicenseNo     String?   @map("driver_license_no") @db.VarChar(64)
  driverLicenseFileId String?   @map("driver_license_file_id") @db.Uuid
  licenseValidUntil   DateTime? @map("license_valid_until") @db.Date
  realnameVerified    Boolean   @default(false) @map("realname_verified")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("customer_identity")
}

model CustomerProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  customerId             String    @unique @map("customer_id") @db.Uuid
  customer               Customer  @relation(fields: [customerId], references: [id])
  occupation             String?   @db.VarChar(128)
  companyName            String?   @map("company_name") @db.VarChar(128)
  monthlyIncomeAmount    BigInt?   @map("monthly_income_amount")
  socialSecurityMonths   Int?      @map("social_security_months")
  housingFundMonths      Int?      @map("housing_fund_months")
  residenceAddress       String?   @map("residence_address") @db.VarChar(255)
  emergencyContactName   String?   @map("emergency_contact_name") @db.VarChar(64)
  emergencyContactMobile String?   @map("emergency_contact_mobile") @db.VarChar(32)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("customer_profile")
}

model CustomerFollowup {
  id             String       @id @default(uuid()) @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
