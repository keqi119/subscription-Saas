{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "build-material-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSha",
    "checkoutRef",
    "ciRunRef",
    "repositoryContractDigest",
    "migrationCatalogDigest",
    "policyDigest",
    "promotionEligibility",
    "images",
    "externalActions",
    "builder",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "build-material-observation.v1" },
    "sourceSha": { "$ref": "#/$defs/sourceSha" },
    "checkoutRef": { "$ref": "#/$defs/sourceSha" },
    "ciRunRef": { "$ref": "#/$defs/nonEmpty" },
    "repositoryContractDigest": { "$ref": "#/$defs/digest" },
    "migrationCatalogDigest": { "$ref": "#/$defs/digest" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "promotionEligibility": { "const": "trusted-candidate" },
    "images": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/image" }
    },
    "externalActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "commitSha"],
        "properties": {
          "name": { "$ref": "#/$defs/nonEmpty" },
          "commitSha": { "$ref": "#/$defs/sourceSha" }
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "provenanceRef"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "provenanceRef": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "observedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "image",
        "platform",
        "digest",
        "sourceRevision",
        "baseImageDigests",
        "builderName",
        "buildAttestationRef",
        "registrySubject",
        "buildRunRef"
      ],
      "properties": {
        "name": { "enum": ["api", "web", "runner"] },
        "image": { "$ref": "#/$defs/nonEmpty" },
        "platform": { "const": "linux/amd64" },
        "digest": { "$ref": "#/$defs/digest" },
        "sourceRevision": { "$ref": "#/$defs/sourceSha" },
        "baseImageDigests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image", "declaredDigest", "digest"],
            "properties": {
              "image": { "$ref": "#/$defs/nonEmpty" },
              "declaredDigest": { "$ref": "#/$defs/digest" },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "builderName": { "$ref": "#/$defs/nonEmpty" },
        "buildAttestationRef": { "$ref": "#/$defs/nonEmpty" },
        "registrySubject": { "$ref": "#/$defs/nonEmpty" },
        "buildRunRef": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
