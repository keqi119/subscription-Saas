{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "post-state-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "attemptId",
    "runId",
    "baselineManifestIdentityDigest",
    "baselineManifestDigest",
    "commandId",
    "commandVersion",
    "planDigest",
    "databaseIdentityFingerprint",
    "postMigrationHead",
    "postSchemaDigest",
    "configurationFingerprint",
    "postconditions",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "post-state-observation.v1" },
    "operationId": { "type": "string", "format": "uuid" },
    "attemptId": { "type": "string", "format": "uuid" },
    "runId": { "type": "string", "format": "uuid" },
    "baselineManifestIdentityDigest": { "$ref": "#/$defs/digest" },
    "baselineManifestDigest": { "$ref": "#/$defs/digest" },
    "commandId": { "$ref": "#/$defs/nonEmpty" },
    "commandVersion": { "$ref": "#/$defs/nonEmpty" },
    "planDigest": { "$ref": "#/$defs/digest" },
    "databaseIdentityFingerprint": { "$ref": "#/$defs/digest" },
    "postMigrationHead": {
      "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9]{14}_[a-z0-9_]+$" }]
    },
    "postSchemaDigest": { "$ref": "#/$defs/digest" },
    "configurationFingerprint": { "$ref": "#/$defs/digest" },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "expectedDigest", "actualDigest"],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmpty" },
          "status": { "enum": ["PASSED", "FAILED"] },
          "expectedDigest": { "$ref": "#/$defs/digest" },
          "actualDigest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "observedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "nonEmpty": { "type": "string", "minLength": 1 }
  }
}
