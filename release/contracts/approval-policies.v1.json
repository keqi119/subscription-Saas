      "commandId": "stage1.clean-acceptance.baseline",
      "commandVersion": "1",
      "environmentClass": "ci-snapshot",
      "dataImpact": "controlled-dml"
    },
    {
      "approvalMode": "human",
      "commandId": "stage1.clean-acceptance.baseline",
