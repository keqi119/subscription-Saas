.setting-heading {
  margin-top: 40rpx;
}
.scenario-option {
  display: block;
  width: 100%;
  background: #fffefa;
  border: 1rpx solid #d9d8d0;
  text-align: left;
  padding: 28rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
  border-radius: 6rpx;
}
.scenario-option.selected {
  border: 2rpx solid #252723;
  background: #eaeae3;
}
.scenario-option .muted {
  font-size: 25rpx;
  margin-top: 10rpx;
}
.fault-options {
  display: flex;
  gap: 12rpx;
}
.fault-option {
  flex: 1;
  font-size: 25rpx;
  background: #eaeae3;
  padding: 22rpx 8rpx;
  line-height: 1.5;
  border: 1rpx solid #d9d8d0;
  border-radius: 6rpx;
}
.fault-option.selected {
  background: #252723;
  color: #fffefa;
}
.fault-help {
  font-size: 25rpx;
  line-height: 1.7;
  margin-top: 20rpx;
}
.return-home {
  margin-top: 44rpx;
}
.reset {
  margin-top: 20rpx;
}

.page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.card {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.notice {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.row .section-title {
  margin-top: 0;
  margin-bottom: 0;
}
