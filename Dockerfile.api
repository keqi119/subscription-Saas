FROM node:22-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN pnpm install --frozen-lockfile

FROM deps AS build

COPY . .
RUN pnpm --filter @subscription-saas/api build

FROM base AS runtime

ARG SOURCE_HAN_SANS_VERSION=2.005R
ARG SOURCE_HAN_SANS_SC_ZIP_URL=https://github.com/adobe-fonts/source-han-sans/releases/download/2.005R/09_SourceHanSansSC.zip
ARG SOURCE_HAN_SANS_SC_ZIP_SHA256=ef7364f7ac2564be1ae9c1d74276de2653fe38b73449070398c4fc0b7e032ff1

ENV NODE_ENV=production
ENV PORT=3001
ENV CONTRACT_PDF_CJK_FONT_PATH=/usr/share/fonts/opentype/source-han-sans/SourceHanSansSC-Regular.otf

WORKDIR /app

RUN apt-get -o Acquire::Retries=3 update \
  && apt-get -o Acquire::Retries=3 install -y --no-install-recommends ca-certificates curl ffmpeg unzip \
  && mkdir -p /usr/share/fonts/opentype/source-han-sans \
  && curl -fsSL "${SOURCE_HAN_SANS_SC_ZIP_URL}" -o /tmp/source-han-sans-sc.zip \
  && echo "${SOURCE_HAN_SANS_SC_ZIP_SHA256}  /tmp/source-han-sans-sc.zip" | sha256sum -c - \
  && unzip -j /tmp/source-han-sans-sc.zip "OTF/SimplifiedChinese/SourceHanSansSC-Regular.otf" -d /usr/share/fonts/opentype/source-han-sans \
  && test -f /usr/share/fonts/opentype/source-han-sans/SourceHanSansSC-Regular.otf \
  && command -v ffmpeg >/dev/null \
  && command -v ffprobe >/dev/null \
  && rm -f /tmp/source-han-sans-sc.zip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
COPY --from=build /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY --from=build /app/apps/api/prisma-env-policy.ts ./apps/api/prisma-env-policy.ts
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/scripts/prisma-migration-checksums.mjs ./scripts/prisma-migration-checksums.mjs
COPY --from=build /app/scripts/stage1-clean-acceptance-baseline-core.mjs ./scripts/stage1-clean-acceptance-baseline-core.mjs
COPY --from=build /app/scripts/stage1-clean-acceptance-baseline-snapshot.mjs ./scripts/stage1-clean-acceptance-baseline-snapshot.mjs
COPY --from=build /app/scripts/stage1-clean-acceptance-baseline-executor.mjs ./scripts/stage1-clean-acceptance-baseline-executor.mjs
COPY --from=build /app/scripts/stage1-clean-acceptance-cli-core.mjs ./scripts/stage1-clean-acceptance-cli-core.mjs
COPY --from=build /app/scripts/stage1-clean-acceptance-baseline.mjs ./scripts/stage1-clean-acceptance-baseline.mjs
COPY --from=build /app/scripts/stage1-clean-acceptance-target-validator.mjs ./scripts/stage1-clean-acceptance-target-validator.mjs
COPY --from=build /app/scripts/stage1-active-source-facts-repair-core.mjs ./scripts/stage1-active-source-facts-repair-core.mjs
COPY --from=build /app/scripts/stage1-active-source-facts-repair-executor.mjs ./scripts/stage1-active-source-facts-repair-executor.mjs
COPY --from=build /app/scripts/stage1-active-source-facts-repair.mjs ./scripts/stage1-active-source-facts-repair.mjs
COPY --from=build /app/scripts/stage1-contract-change-bootstrap-core.mjs ./scripts/stage1-contract-change-bootstrap-core.mjs
COPY --from=build /app/scripts/stage1-contract-change-bootstrap.mjs ./scripts/stage1-contract-change-bootstrap.mjs
COPY --from=build /app/scripts/stage1-return-closure-backfill-core.mjs ./scripts/stage1-return-closure-backfill-core.mjs
COPY --from=build /app/scripts/stage1-return-closure-backfill.mjs ./scripts/stage1-return-closure-backfill.mjs
COPY --from=build /app/scripts/stage1-staging-invalid-test-order-retirement-core.mjs ./scripts/stage1-staging-invalid-test-order-retirement-core.mjs
COPY --from=build /app/scripts/stage1-staging-invalid-test-order-retirement-executor.mjs ./scripts/stage1-staging-invalid-test-order-retirement-executor.mjs
COPY --from=build /app/scripts/stage1-staging-invalid-test-order-retirement.mjs ./scripts/stage1-staging-invalid-test-order-retirement.mjs
COPY --from=build /app/scripts/stage1c-period-backfill-core.mjs ./scripts/stage1c-period-backfill-core.mjs
COPY --from=build /app/scripts/stage1c-period-backfill-executor.mjs ./scripts/stage1c-period-backfill-executor.mjs
COPY --from=build /app/scripts/stage1c-period-backfill.mjs ./scripts/stage1c-period-backfill.mjs
COPY --from=build /app/scripts/subscription-segment-bootstrap-core.mjs ./scripts/subscription-segment-bootstrap-core.mjs
COPY --from=build /app/scripts/subscription-segment-bootstrap.mjs ./scripts/subscription-segment-bootstrap.mjs

RUN mkdir -p /app/uploads /app/apps/api/uploads

EXPOSE 3001

CMD ["node", "apps/api/dist/src/main.js"]
