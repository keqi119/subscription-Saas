{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "manual-runner-request.v5",
  "required": [
    "schemaVersion",
    "profileDigest",
    "ownerId",
    "sessionId",
    "sessionNonce",
    "operationId",
    "idempotencyKey",
    "attemptId",
    "runId",
    "attemptAllocationDigest",
    "stage",
    "capability",
    "purpose",
    "phase",
    "chain",
    "sourceSha",
    "targetPolicyDigest",
    "creationSpecDigest",
    "jobAdmissionDigest",
    "destinationAdmissionDigest",
    "preparationExecutionRecordDigest",
    "databaseTestManifestDigest",
    "candidate"
  ],
  "properties": {
    "schemaVersion": {
      "const": "manual-runner-request.v5"
    },
    "profileDigest": {
      "$ref": "#/$defs/digest"
    },
    "ownerId": {
      "$ref": "#/$defs/label"
    },
    "sessionId": {
      "$ref": "#/$defs/uuid"
    },
    "sessionNonce": {
      "$ref": "#/$defs/nonce"
    },
    "operationId": {
      "$ref": "#/$defs/uuid"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/label"
    },
    "attemptId": {
      "$ref": "#/$defs/uuid"
    },
    "runId": {
      "$ref": "#/$defs/uuid"
    },
    "attemptAllocationDigest": {
      "$ref": "#/$defs/digest"
    },
    "stage": {
      "const": "candidate-use"
    },
    "capability": {
      "const": "execute-source-database-tests"
    },
    "purpose": {
      "const": "stage1-isolated-database-tests"
    },
    "phase": {
      "const": "source"
    },
    "chain": {
      "enum": ["fresh", "snapshot"]
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "targetPolicyDigest": {
      "$ref": "#/$defs/digest"
    },
    "creationSpecDigest": {
      "$ref": "#/$defs/digest"
    },
    "jobAdmissionDigest": {
      "$ref": "#/$defs/digest"
    },
    "destinationAdmissionDigest": {
      "$ref": "#/$defs/digest"
    },
    "preparationExecutionRecordDigest": {
      "$ref": "#/$defs/digest"
    },
    "databaseTestManifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildProofDigest"],
      "properties": {
        "buildProofDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
