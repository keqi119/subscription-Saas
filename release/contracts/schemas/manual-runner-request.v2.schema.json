{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manual-runner-request.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileDigest",
    "ownerId",
    "sessionId",
    "sessionNonce",
    "operationId",
    "idempotencyKey",
    "attemptId",
    "runId",
    "attemptAllocationDigest",
    "stage",
    "capability",
    "purpose",
    "phase",
    "sourceSha",
    "scopeAuthorizationDigest",
    "destinationAdmissionDigest",
    "input"
  ],
  "properties": {
    "schemaVersion": { "const": "manual-runner-request.v2" },
    "profileDigest": { "$ref": "#/$defs/digest" },
    "ownerId": { "$ref": "#/$defs/label" },
    "sessionId": { "$ref": "#/$defs/uuid" },
    "sessionNonce": { "$ref": "#/$defs/nonce" },
    "operationId": { "$ref": "#/$defs/uuid" },
    "idempotencyKey": { "$ref": "#/$defs/label" },
    "attemptId": { "$ref": "#/$defs/uuid" },
    "runId": { "$ref": "#/$defs/uuid" },
    "attemptAllocationDigest": { "$ref": "#/$defs/digest" },
    "stage": { "const": "snapshot-consumer" },
    "capability": { "const": "read-decrypt-use" },
    "purpose": { "const": "sanitized-snapshot-test-input" },
    "phase": { "enum": ["prebuild-source", "rc-source", "final"] },
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "scopeAuthorizationDigest": { "$ref": "#/$defs/digest" },
    "destinationAdmissionDigest": { "$ref": "#/$defs/digest" },
    "input": { "type": "object" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "matchingRcSourceEvidenceDigest": { "$ref": "#/$defs/digest" }
  },
  "oneOf": [
    {
      "properties": {
        "phase": { "const": "prebuild-source" },
        "input": { "$ref": "#/$defs/prebuildInput" },
        "candidate": false,
        "matchingRcSourceEvidenceDigest": false
      }
    },
    {
      "required": ["candidate"],
      "properties": {
        "phase": { "const": "rc-source" },
        "input": { "$ref": "#/$defs/rcInput" },
        "matchingRcSourceEvidenceDigest": false
      }
    },
    {
      "required": ["candidate", "matchingRcSourceEvidenceDigest"],
      "properties": {
        "phase": { "const": "final" },
        "input": { "$ref": "#/$defs/rcInput" }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 256 },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "prebuildInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prebuildBindingDigest"],
      "properties": { "prebuildBindingDigest": { "$ref": "#/$defs/digest" } }
    },
    "rcInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privateCustodyDigest",
        "producerCompletionDigest",
        "producerTerminalObservationDigest"
      ],
      "properties": {
        "privateCustodyDigest": { "$ref": "#/$defs/digest" },
        "producerCompletionDigest": { "$ref": "#/$defs/digest" },
        "producerTerminalObservationDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildProofDigest",
        "buildBundleDigest",
        "dispatchAuthorizationDigest",
        "rcWorkflowRunId"
      ],
      "properties": {
        "buildProofDigest": { "$ref": "#/$defs/digest" },
        "buildBundleDigest": { "$ref": "#/$defs/digest" },
        "dispatchAuthorizationDigest": { "$ref": "#/$defs/digest" },
        "rcWorkflowRunId": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    }
  }
}
