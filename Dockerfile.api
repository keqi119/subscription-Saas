FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN pnpm install --frozen-lockfile

FROM deps AS build

COPY . .
RUN pnpm --filter @subscription-saas/api build

FROM build AS production-deps

RUN pnpm --filter @subscription-saas/api deploy --prod --legacy --offline /prod/api \
  && source_client_parent="$(dirname "$(dirname "$(readlink -f /app/apps/api/node_modules/@prisma/client)")")" \
  && deployed_client_parent="$(dirname "$(dirname "$(readlink -f /prod/api/node_modules/@prisma/client)")")" \
  && cp -a "$source_client_parent/.prisma" "$deployed_client_parent/.prisma" \
  && find /prod/api/node_modules \( -path '*/node_modules/prisma' -o -path '*/node_modules/.bin/prisma' \) -prune -exec rm -rf '{}' + \
  && node -e "const { PrismaClient } = require('/prod/api/node_modules/@prisma/client'); if (typeof PrismaClient !== 'function') process.exit(1)" \
  && test -z "$(find /prod/api/node_modules \( -path '*/node_modules/prisma' -o -path '*/node_modules/.bin/prisma' \) -print -quit)"

FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS runtime

ARG API_SOURCE_REVISION
ARG SOURCE_HAN_SANS_VERSION=2.005R
ARG SOURCE_HAN_SANS_SC_ZIP_URL=https://github.com/adobe-fonts/source-han-sans/releases/download/2.005R/09_SourceHanSansSC.zip
ARG SOURCE_HAN_SANS_SC_ZIP_SHA256=ef7364f7ac2564be1ae9c1d74276de2653fe38b73449070398c4fc0b7e032ff1

ENV NODE_ENV=production
ENV PORT=3001
ENV CONTRACT_PDF_CJK_FONT_PATH=/usr/share/fonts/opentype/source-han-sans/SourceHanSansSC-Regular.otf

RUN test "${#API_SOURCE_REVISION}" -eq 40 \
  && printf '%s' "$API_SOURCE_REVISION" | grep -Eq '^[0-9a-f]{40}$'

LABEL org.opencontainers.image.revision="${API_SOURCE_REVISION}"

WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  rm -f /etc/apt/apt.conf.d/docker-clean \
  && install_attempt=1 \
  && until apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 -o Binary::apt::APT::Keep-Downloaded-Packages=true install -y --no-install-recommends ca-certificates curl ffmpeg unzip; do \
    if [ "$install_attempt" -ge 5 ]; then exit 1; fi; \
    install_attempt=$((install_attempt + 1)); \
  done \
  && mkdir -p /usr/share/fonts/opentype/source-han-sans \
  && curl --retry 5 --retry-all-errors --retry-delay 2 -fsSL "${SOURCE_HAN_SANS_SC_ZIP_URL}" -o /tmp/source-han-sans-sc.zip \
  && echo "${SOURCE_HAN_SANS_SC_ZIP_SHA256}  /tmp/source-han-sans-sc.zip" | sha256sum -c - \
  && unzip -j /tmp/source-han-sans-sc.zip "OTF/SimplifiedChinese/SourceHanSansSC-Regular.otf" -d /usr/share/fonts/opentype/source-han-sans \
  && test -f /usr/share/fonts/opentype/source-han-sans/SourceHanSansSC-Regular.otf \
  && command -v ffmpeg >/dev/null \
  && command -v ffprobe >/dev/null \
  && rm -f /tmp/source-han-sans-sc.zip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=production-deps /prod/api/node_modules ./apps/api/node_modules
COPY --from=production-deps /prod/api/dist ./apps/api/dist

RUN node -e "const { PrismaClient } = require('/app/apps/api/node_modules/@prisma/client'); if (typeof PrismaClient !== 'function') process.exit(1)" \
  && test ! -e /app/apps/api/node_modules/.bin/prisma \
  && test ! -e /app/scripts \
  && ! command -v psql >/dev/null 2>&1

RUN mkdir -p /app/uploads /app/apps/api/uploads

EXPOSE 3001

CMD ["node", "apps/api/dist/src/main.js"]
