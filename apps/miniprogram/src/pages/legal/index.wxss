.legal-intro {
  font-size: 32rpx;
  line-height: 1.8;
  margin: 36rpx 0 48rpx;
  color: #575a52;
}
.legal-section {
  padding: 28rpx 0;
  border-top: 1rpx solid #d9d8d0;
}
.legal-body {
  font-size: 29rpx;
  line-height: 1.9;
  color: #575a52;
}
.legal-section .section-title {
  font-size: 31rpx;
  margin-bottom: 18rpx;
}

.page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.card {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.notice {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.row .section-title {
  margin-top: 0;
  margin-bottom: 0;
}
