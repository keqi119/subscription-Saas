{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapshot-metadata.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dumpDigest",
    "sourceMigrationHead",
    "sourcePrivilegeObservationDigest",
    "sourceFingerprintBeforeDigest",
    "sourceFingerprintAfterDigest",
    "sanitizationContractDigest",
    "ownershipMapDigest",
    "ownershipContractVersion",
    "scanDigest",
    "scanSubjectDigest",
    "exportToolVersion",
    "scanToolVersion",
    "createdAt",
    "reviewAt",
    "expiresAt",
    "owner",
    "readers",
    "accessPolicyRef",
    "workflowRunRef"
  ],
  "properties": {
    "schemaVersion": { "const": "snapshot-metadata.v1" },
    "dumpDigest": { "$ref": "#/$defs/digest" },
    "sourceMigrationHead": { "$ref": "#/$defs/migration" },
    "sourcePrivilegeObservationDigest": { "$ref": "#/$defs/digest" },
    "sourceFingerprintBeforeDigest": { "$ref": "#/$defs/digest" },
    "sourceFingerprintAfterDigest": { "$ref": "#/$defs/digest" },
    "sanitizationContractDigest": { "$ref": "#/$defs/digest" },
    "ownershipMapDigest": { "$ref": "#/$defs/digest" },
    "ownershipContractVersion": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "scanDigest": { "$ref": "#/$defs/digest" },
    "scanSubjectDigest": { "$ref": "#/$defs/digest" },
    "exportToolVersion": { "$ref": "#/$defs/nonEmpty" },
    "scanToolVersion": { "$ref": "#/$defs/nonEmpty" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "reviewAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "owner": { "$ref": "#/$defs/nonEmpty" },
    "readers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "accessPolicyRef": { "$ref": "#/$defs/nonEmpty" },
    "workflowRunRef": { "$ref": "#/$defs/nonEmpty" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "migration": { "type": "string", "pattern": "^[0-9]{14}_[a-z0-9_]+$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "nonEmpty": { "type": "string", "minLength": 1 }
  }
}
