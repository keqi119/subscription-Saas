generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum RoleCode {
  SA
  OP
  RC
  FI
  AS
  CS
  GM
  ADMIN

  @@map("role_code")
}

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT

  @@map("audit_action")
}

enum CustomerType {
  PERSONAL
  COMPANY

  @@map("customer_type")
}

enum CustomerGrade {
  A
  B
  C

  @@map("customer_grade")
}

enum CustomerStatus {
  LEAD
  PENDING_APPLICATION
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTIVE
  FROZEN
  BLACKLISTED

  @@map("customer_status")
}

enum FollowupType {
  PHONE
  WECHAT
  VISIT
  OTHER

  @@map("followup_type")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  NEED_MORE_INFO
  APPROVED
  REJECTED
  CANCELLED

  @@map("application_status")
}

enum ApplicationMaterialType {
  ID_CARD
  DRIVER_LICENSE
  BANK_FLOW
  WORK_PROOF
  RESIDENCE_PROOF
  CREDIT_AUTH
  OTHER

  @@map("application_material_type")
}

enum MaterialStatus {
  PENDING
  APPROVED
  NEED_MORE_INFO
  VERIFIED
  REJECTED

  @@map("material_status")
}

enum ApplicationActionType {
  CREATE
  UPLOAD_MATERIAL
  UPLOAD_MATERIAL_FILE
  SUBMIT
  REVIEW_MATERIAL
  REVIEW_MATERIAL_GROUP
  APPROVE
  NEED_MORE_INFO
  REJECT
  DELETE_MATERIAL_FILE

  @@map("application_action_type")
}

enum RiskResultDecision {
  APPROVED
  REJECTED
  NEED_MORE_INFO

  @@map("risk_result_decision")
}

enum ProductType {
  SUBSCRIPTION
  RENT_TO_OWN

  @@map("product_type")
}

enum BusinessType {
  SUBSCRIPTION
  RENT_TO_OWN

  @@map("business_type")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum ProductVersionStatus {
  DRAFT
  APPROVED
  ACTIVE
  INACTIVE

  @@map("product_version_status")
}

enum QuoteStatus {
  DRAFT
  CONFIRMED
  EXPIRED
  CANCELLED

  @@map("quote_status")
}

enum SubscriptionPlanStatus {
  DRAFT
  ACTIVE
  INACTIVE

  @@map("subscription_plan_status")
}

enum MonthlyFeeMode {
  MANUAL_QUOTE
  FIXED_AMOUNT
  RATE_FORMULA

  @@map("monthly_fee_mode")
}

enum OrderStatus {
  PENDING_CONTRACT
  PENDING_SIGN
  PENDING_PAYMENT
  PENDING_VEHICLE
  PENDING_DELIVERY
  ACTIVE
  SUSPENDED
  TERMINATED
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum ContractStatus {
  DRAFT
  GENERATED
  SIGNING
  SIGNED
  ARCHIVED
  TERMINATED
  CANCELLED

  @@map("contract_status")
}

enum ContractVersionStatus {
  DRAFT
  ACTIVE
  INACTIVE

  @@map("contract_version_status")
}

enum ContractTemplateType {
  SUBSCRIPTION_STANDARD

  @@map("contract_template_type")
}

enum OrderChangeType {
  PLAN_CHANGE
  RESTRUCTURE
  VEHICLE_SWAP
  EXTENSION
  TERMINATION
  CANCEL_ORDER
  BUYOUT
  EARLY_SETTLEMENT
  OWNERSHIP_TRANSFER

  @@map("order_change_type")
}

enum OrderChangeStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED

  @@map("order_change_status")
}

enum VehicleModel {
  ET5
  ET7
  ES6

  @@map("vehicle_model")
}

enum VehicleStatus {
  DRAFT
  IN_PREPARATION
  AVAILABLE
  RESERVED
  LEASED
  RENTED
  RETURNED
  MAINTENANCE
  RETIRED

  @@map("vehicle_status")
}

enum SalePriceStatus {
  PENDING_INITIALIZE
  EFFECTIVE
  REVIEW_DUE
  EXPIRED

  @@map("sale_price_status")
}

enum VehicleSalePriceReviewType {
  INITIAL_POOL
  QUARTERLY_REVIEW
  RETURN_REINIT
  MANUAL_ADJUST

  @@map("vehicle_sale_price_review_type")
}

enum BenefitType {
  WASH_CAR
  CAR_SWAP
  POINTS
  DRIVER_SERVICE
  OTHER

  @@map("benefit_type")
}

model User {
  id            String             @id @default(uuid()) @db.Uuid
  username      String             @unique @db.VarChar(64)
  name          String             @db.VarChar(64)
  mobile        String?            @db.VarChar(32)
  email         String?            @unique @db.VarChar(128)
  passwordHash  String             @map("password_hash") @db.VarChar(255)
  status        UserStatus         @default(ACTIVE)
  lastLoginAt   DateTime?          @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?            @map("created_by") @db.Uuid
  updatedBy     String?            @map("updated_by") @db.Uuid
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz(6)
  roles         UserRole[]
  customers     Customer[]         @relation("CustomerOwner")
  applications  Application[]      @relation("ApplicationSales")
  uploadedFiles FileObject[]       @relation("FileUploader")
  followups     CustomerFollowup[] @relation("FollowupUser")
  riskResults   RiskResult[]       @relation("RiskResultApprover")
  reviewedMaterials ApplicationMaterial[] @relation("MaterialReviewer")
  reviewedMaterialGroups ApplicationMaterialGroup[] @relation("MaterialGroupReviewer")
  uploadedMaterialFiles ApplicationMaterialFile[] @relation("MaterialFileUploader")
  deletedMaterialFiles ApplicationMaterialFile[] @relation("MaterialFileDeleter")
  applicationActionLogs ApplicationActionLog[] @relation("ApplicationActionOperator")
  approvedProductVersions ProductVersion[] @relation("ProductVersionApprover")
  confirmedQuotes SubscriptionQuote[] @relation("QuoteConfirmer")
  approvedContractVersions ContractVersion[] @relation("ContractVersionApprover")
  approvedOrderChanges OrderChange[] @relation("OrderChangeApprover")

  @@index([status])
  @@map("user")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  name        String           @db.VarChar(64)
  description String?          @db.Text
  status      RecordStatus     @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]
  menus       RoleMenu[]

  @@index([status])
  @@map("role")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(128)
  name        String           @db.VarChar(128)
  module      String           @db.VarChar(64)
  action      String           @db.VarChar(64)
  description String?          @db.Text
  status      RecordStatus     @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@index([module])
  @@index([status])
  @@map("permission")
}

model Menu {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique @db.VarChar(128)
  name           String       @db.VarChar(128)
  path           String       @db.VarChar(255)
  icon           String?      @db.VarChar(64)
  sortOrder      Int          @default(0) @map("sort_order")
  permissionCode String?      @map("permission_code") @db.VarChar(128)
  parentId       String?      @map("parent_id") @db.Uuid
  parent         Menu?        @relation("MenuTree", fields: [parentId], references: [id])
  children       Menu[]       @relation("MenuTree")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  roles          RoleMenu[]

  @@index([parentId])
  @@index([status])
  @@map("menu")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model RoleMenu {
  id        String    @id @default(uuid()) @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  menuId    String    @map("menu_id") @db.Uuid
  role      Role      @relation(fields: [roleId], references: [id])
  menu      Menu      @relation(fields: [menuId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([roleId, menuId])
  @@index([menuId])
  @@map("role_menu")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  module         String      @db.VarChar(64)
  entityType     String      @map("entity_type") @db.VarChar(64)
  entityId       String?     @map("entity_id") @db.Uuid
  action         AuditAction
  beforeSnapshot Json?       @map("before_snapshot")
  afterSnapshot  Json?       @map("after_snapshot")
  operatorId     String?     @map("operator_id") @db.Uuid
  ipAddress      String?     @map("ip_address") @db.VarChar(64)
  userAgent      String?     @map("user_agent") @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([module])
  @@index([entityType, entityId])
  @@index([operatorId])
  @@index([createdAt])
  @@map("audit_log")
}

model Customer {
  id            String             @id @default(uuid()) @db.Uuid
  customerNo    String             @unique @map("customer_no") @db.VarChar(64)
  name          String             @db.VarChar(64)
  mobile        String             @db.VarChar(32)
  customerType  CustomerType       @default(PERSONAL) @map("customer_type")
  sourceChannel String?            @map("source_channel") @db.VarChar(64)
  grade         CustomerGrade?
  riskScore     Int?               @map("risk_score")
  status        CustomerStatus     @default(LEAD)
  ownerUserId   String?            @map("owner_user_id") @db.Uuid
  ownerUser     User?              @relation("CustomerOwner", fields: [ownerUserId], references: [id])
  remark        String?            @db.Text
  identity      CustomerIdentity?
  profile       CustomerProfile?
  followups     CustomerFollowup[]
  applications  Application[]
  riskResults   RiskResult[]
  quotes        SubscriptionQuote[]
  orders        SubscriptionOrder[]
  contracts     Contract[]
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?            @map("created_by") @db.Uuid
  updatedBy     String?            @map("updated_by") @db.Uuid
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz(6)

  @@index([mobile])
  @@index([ownerUserId])
  @@index([status])
  @@map("customer")
}

model CustomerIdentity {
  id                  String    @id @default(uuid()) @db.Uuid
  customerId          String    @unique @map("customer_id") @db.Uuid
  customer            Customer  @relation(fields: [customerId], references: [id])
  idCardNo            String?   @map("id_card_no") @db.VarChar(32)
  idCardFrontFileId   String?   @map("id_card_front_file_id") @db.Uuid
  idCardBackFileId    String?   @map("id_card_back_file_id") @db.Uuid
  driverLicenseNo     String?   @map("driver_license_no") @db.VarChar(64)
  driverLicenseFileId String?   @map("driver_license_file_id") @db.Uuid
  licenseValidUntil   DateTime? @map("license_valid_until") @db.Date
  realnameVerified    Boolean   @default(false) @map("realname_verified")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("customer_identity")
}

model CustomerProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  customerId             String    @unique @map("customer_id") @db.Uuid
  customer               Customer  @relation(fields: [customerId], references: [id])
  occupation             String?   @db.VarChar(128)
  companyName            String?   @map("company_name") @db.VarChar(128)
  monthlyIncomeAmount    BigInt?   @map("monthly_income_amount")
  socialSecurityMonths   Int?      @map("social_security_months")
  housingFundMonths      Int?      @map("housing_fund_months")
  residenceAddress       String?   @map("residence_address") @db.VarChar(255)
  emergencyContactName   String?   @map("emergency_contact_name") @db.VarChar(64)
  emergencyContactMobile String?   @map("emergency_contact_mobile") @db.VarChar(32)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("customer_profile")
}

model CustomerFollowup {
  id             String       @id @default(uuid()) @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  customer       Customer     @relation(fields: [customerId], references: [id])
  followupUserId String       @map("followup_user_id") @db.Uuid
  followupUser   User         @relation("FollowupUser", fields: [followupUserId], references: [id])
  followupType   FollowupType @default(PHONE) @map("followup_type")
  content        String       @db.Text
  nextFollowupAt DateTime?    @map("next_followup_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@index([customerId])
  @@index([followupUserId])
  @@map("customer_followup")
}

model Application {
  id                   String                @id @default(uuid()) @db.Uuid
  applicationNo        String                @unique @map("application_no") @db.VarChar(64)
  customerId           String                @map("customer_id") @db.Uuid
  customer             Customer              @relation(fields: [customerId], references: [id])
  salesUserId          String                @map("sales_user_id") @db.Uuid
  salesUser            User                  @relation("ApplicationSales", fields: [salesUserId], references: [id])
  intendedModel        String?               @map("intended_model") @db.VarChar(64)
  intendedPeriodMonths Int?                  @map("intended_period_months")
  status               ApplicationStatus     @default(DRAFT)
  submittedAt          DateTime?             @map("submitted_at") @db.Timestamptz(6)
  approvedAt           DateTime?             @map("approved_at") @db.Timestamptz(6)
  rejectedReason       String?               @map("rejected_reason") @db.Text
  materials            ApplicationMaterial[]
  materialGroups       ApplicationMaterialGroup[]
  materialFiles        ApplicationMaterialFile[]
  riskResults          RiskResult[]
  actionLogs           ApplicationActionLog[]
  quotes               SubscriptionQuote[]
  orders               SubscriptionOrder[]
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy            String?               @map("created_by") @db.Uuid
  updatedBy            String?               @map("updated_by") @db.Uuid
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(6)

  @@index([customerId])
  @@index([salesUserId])
  @@index([status])
  @@map("application")
}

model ApplicationMaterial {
  id            String                  @id @default(uuid()) @db.Uuid
  applicationId String                  @map("application_id") @db.Uuid
  application   Application             @relation(fields: [applicationId], references: [id])
  materialType  ApplicationMaterialType @map("material_type")
  materialName  String?                 @map("material_name") @db.VarChar(128)
  fileId        String                  @map("file_id") @db.Uuid
  file          FileObject              @relation(fields: [fileId], references: [id])
  status        MaterialStatus          @default(PENDING)
  reviewRemark  String?                 @map("review_remark") @db.Text
  reviewComment String?                 @map("review_comment") @db.Text
  reviewedBy    String?                 @map("reviewed_by") @db.Uuid
  reviewer      User?                   @relation("MaterialReviewer", fields: [reviewedBy], references: [id])
  reviewedAt    DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  actionLogs    ApplicationActionLog[]
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?                 @map("created_by") @db.Uuid
  updatedBy     String?                 @map("updated_by") @db.Uuid
  deletedAt     DateTime?               @map("deleted_at") @db.Timestamptz(6)

  @@index([applicationId])
  @@index([fileId])
  @@index([reviewedBy])
  @@index([status])
  @@map("application_material")
}

model ApplicationMaterialGroup {
  id            String                    @id @default(uuid()) @db.Uuid
  applicationId String                    @map("application_id") @db.Uuid
  application   Application               @relation(fields: [applicationId], references: [id])
  materialType  ApplicationMaterialType   @map("material_type")
  materialName  String?                   @map("material_name") @db.VarChar(128)
  required      Boolean                   @default(false)
  reviewStatus  MaterialStatus            @default(PENDING) @map("review_status")
  reviewComment String?                   @map("review_comment") @db.Text
  reviewedBy    String?                   @map("reviewed_by") @db.Uuid
  reviewer      User?                     @relation("MaterialGroupReviewer", fields: [reviewedBy], references: [id])
  reviewedAt    DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  files         ApplicationMaterialFile[]
  actionLogs    ApplicationActionLog[]
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?                   @map("created_by") @db.Uuid
  updatedBy     String?                   @map("updated_by") @db.Uuid
  deletedAt     DateTime?                 @map("deleted_at") @db.Timestamptz(6)

  @@unique([applicationId, materialType])
  @@index([applicationId])
  @@index([materialType])
  @@index([reviewStatus])
  @@index([reviewedBy])
  @@map("application_material_group")
}

model ApplicationMaterialFile {
  id              String                   @id @default(uuid()) @db.Uuid
  materialGroupId String                   @map("material_group_id") @db.Uuid
  materialGroup   ApplicationMaterialGroup @relation(fields: [materialGroupId], references: [id])
  applicationId   String                   @map("application_id") @db.Uuid
  application     Application              @relation(fields: [applicationId], references: [id])
  materialType    ApplicationMaterialType  @map("material_type")
  fileId          String                   @map("file_id") @db.Uuid
  file            FileObject               @relation(fields: [fileId], references: [id])
  fileName        String                   @map("file_name") @db.VarChar(255)
  mimeType        String?                  @map("mime_type") @db.VarChar(128)
  sizeBytes       BigInt                   @map("size_bytes")
  uploadedBy      String?                  @map("uploaded_by") @db.Uuid
  uploader        User?                    @relation("MaterialFileUploader", fields: [uploadedBy], references: [id])
  uploadedAt      DateTime                 @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  isDeleted       Boolean                  @default(false) @map("is_deleted")
  deletedBy       String?                  @map("deleted_by") @db.Uuid
  deleter         User?                    @relation("MaterialFileDeleter", fields: [deletedBy], references: [id])
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(6)
  deleteReason    String?                  @map("delete_reason") @db.Text
  actionLogs      ApplicationActionLog[]
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?                  @map("created_by") @db.Uuid
  updatedBy       String?                  @map("updated_by") @db.Uuid

  @@index([materialGroupId])
  @@index([applicationId])
  @@index([materialType])
  @@index([fileId])
  @@index([uploadedBy])
  @@index([deletedBy])
  @@index([isDeleted])
  @@map("application_material_file")
}

model ApplicationActionLog {
  id              String                @id @default(uuid()) @db.Uuid
  applicationId   String                @map("application_id") @db.Uuid
  application     Application           @relation(fields: [applicationId], references: [id])
  materialId      String?               @map("material_id") @db.Uuid
  material        ApplicationMaterial?  @relation(fields: [materialId], references: [id])
  materialGroupId String?               @map("material_group_id") @db.Uuid
  materialGroup   ApplicationMaterialGroup? @relation(fields: [materialGroupId], references: [id])
  materialFileId  String?               @map("material_file_id") @db.Uuid
  materialFile    ApplicationMaterialFile? @relation(fields: [materialFileId], references: [id])
  actionType      ApplicationActionType @map("action_type")
  fromStatus      ApplicationStatus?    @map("from_status")
  toStatus        ApplicationStatus?    @map("to_status")
  comment         String?               @db.Text
  operatorId      String?               @map("operator_id") @db.Uuid
  operator        User?                 @relation("ApplicationActionOperator", fields: [operatorId], references: [id])
  operatorName    String?               @map("operator_name") @db.VarChar(64)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?               @map("created_by") @db.Uuid
