.record-summary {
  margin: 28rpx 0;
}
.record-summary .muted {
  margin-top: 18rpx;
}
.detail-amount {
  margin: 36rpx 0;
  font-size: 56rpx;
}
.record-id {
  font-size: 26rpx;
  overflow-wrap: anywhere;
  margin-bottom: 24rpx;
}
.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  border-top: 1rpx solid #e1e0d9;
  padding: 24rpx 0;
  font-size: 28rpx;
}
.detail-value {
  text-align: right;
  max-width: 68%;
  overflow-wrap: anywhere;
}
.timeline-row {
  display: flex;
  gap: 22rpx;
  margin: 26rpx 0;
}
.timeline-row .muted {
  margin-top: 8rpx;
  font-size: 26rpx;
}
.timeline-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #a8aaa1;
  border-radius: 50%;
  margin-top: 10rpx;
}
.timeline-dot.done {
  background: #252723;
  border-color: #252723;
}
.document {
  padding: 22rpx 0;
  border-top: 1rpx solid #e1e0d9;
}
.document .muted {
  margin-top: 10rpx;
  font-size: 26rpx;
}
.back-link {
  margin-top: 36rpx;
}

.page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.card {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.notice {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.row .section-title {
  margin-top: 0;
  margin-bottom: 0;
}
