{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapshot-jit-launch-proof.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotAdmissionDigest",
    "environmentPolicyIdentityDigest",
    "environmentPolicyObservationDigest",
    "routeLabel",
    "assignedRunner",
    "jitConfigurationDigest",
    "launchedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "snapshot-jit-launch-proof.v1" },
    "snapshotAdmissionDigest": { "$ref": "#/$defs/digest" },
    "environmentPolicyIdentityDigest": { "$ref": "#/$defs/digest" },
    "environmentPolicyObservationDigest": { "$ref": "#/$defs/digest" },
    "routeLabel": {
      "type": "string",
      "pattern": "^stage1-snapshot-export-[1-9][0-9]*-[0-9a-f]{32}$"
    },
    "assignedRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "labels"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "name": { "type": "string", "minLength": 1 },
        "labels": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "jitConfigurationDigest": { "$ref": "#/$defs/digest" },
    "launchedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "rfc3339Finite": true,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"
    }
  }
}
