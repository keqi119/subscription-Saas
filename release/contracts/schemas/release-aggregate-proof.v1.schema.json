{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-aggregate-proof.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSha",
    "workflowRun",
    "buildProofDigest",
    "releaseImages",
    "contracts",
    "sourceGateEvidence",
    "finalComposeEvidence",
    "finalArtifactExecutions",
    "composeEvidenceDigest",
    "apiReadinessEvidenceDigest",
    "webClientEvidenceDigest",
    "custodyReceiptDigests",
    "attemptHistoryDigest",
    "aggregatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "release-aggregate-proof.v1" },
    "sourceSha": { "$ref": "#/$defs/sourceSha" },
    "workflowRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflowPath", "runId", "runAttempt", "sourceSha"],
      "properties": {
        "repository": { "const": "keqi119/subscription-Saas" },
        "workflowPath": { "const": ".github/workflows/release-candidate-gate.yml" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "sourceSha": { "$ref": "#/$defs/sourceSha" }
      }
    },
    "buildProofDigest": { "$ref": "#/$defs/digest" },
    "releaseImages": { "$ref": "#/$defs/images" },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrationCatalogDigest",
        "repositoryContractDigest",
        "databaseTestManifestDigest",
        "databaseTestDiscoveryDigest",
        "postgresImageDigest",
        "snapshotMetadataDigest"
      ],
      "properties": {
        "migrationCatalogDigest": { "$ref": "#/$defs/digest" },
        "repositoryContractDigest": { "$ref": "#/$defs/digest" },
        "databaseTestManifestDigest": { "$ref": "#/$defs/digest" },
        "databaseTestDiscoveryDigest": { "$ref": "#/$defs/digest" },
        "postgresImageDigest": { "$ref": "#/$defs/digest" },
        "snapshotMetadataDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "sourceGateEvidence": { "$ref": "#/$defs/chains" },
    "finalComposeEvidence": { "$ref": "#/$defs/chains" },
    "finalArtifactExecutions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh", "snapshot"],
      "properties": {
        "fresh": { "$ref": "#/$defs/execution" },
        "snapshot": { "$ref": "#/$defs/execution" }
      }
    },
    "composeEvidenceDigest": { "$ref": "#/$defs/digest" },
    "apiReadinessEvidenceDigest": { "$ref": "#/$defs/digest" },
    "webClientEvidenceDigest": { "$ref": "#/$defs/digest" },
    "custodyReceiptDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildProof",
        "snapshotMetadata",
        "sourceFresh",
        "sourceSnapshot",
        "finalFresh",
        "finalSnapshot"
      ],
      "properties": {
        "buildProof": { "$ref": "#/$defs/digest" },
        "snapshotMetadata": { "$ref": "#/$defs/digest" },
        "sourceFresh": { "$ref": "#/$defs/digest" },
        "sourceSnapshot": { "$ref": "#/$defs/digest" },
        "finalFresh": { "$ref": "#/$defs/digest" },
        "finalSnapshot": { "$ref": "#/$defs/digest" }
      }
    },
    "attemptHistoryDigest": { "$ref": "#/$defs/digest" },
    "aggregatedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "chains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh", "snapshot"],
      "properties": {
        "fresh": { "$ref": "#/$defs/digest" },
        "snapshot": { "$ref": "#/$defs/digest" }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "web", "runner"],
      "properties": {
        "api": { "$ref": "#/$defs/imageReference" },
        "web": { "$ref": "#/$defs/imageReference" },
        "runner": { "$ref": "#/$defs/imageReference" }
      }
    },
    "imageReference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[0-9a-f]{64}$"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestDigest",
        "manifestIdentityDigest",
        "postStateObservationDigest",
        "executionProofDigest"
      ],
      "properties": {
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "manifestIdentityDigest": { "$ref": "#/$defs/digest" },
        "postStateObservationDigest": { "$ref": "#/$defs/digest" },
        "executionProofDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
