{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "database-test-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "discoveryDigest",
    "manifestDigest",
    "exceptionsDigest",
    "candidateCount",
    "manifestedCount",
    "exceptedCount",
    "unclassifiedCount",
    "candidates",
    "unclassified"
  ],
  "properties": {
    "schemaVersion": { "const": "database-test-report.v1" },
    "discoveryDigest": { "$ref": "#/$defs/digest" },
    "manifestDigest": { "$ref": "#/$defs/digest" },
    "exceptionsDigest": { "$ref": "#/$defs/digest" },
    "candidateCount": { "type": "integer", "minimum": 0 },
    "manifestedCount": { "type": "integer", "minimum": 0 },
    "exceptedCount": { "type": "integer", "minimum": 0 },
    "unclassifiedCount": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reasons"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "filename-pattern",
                "database-client-import",
                "database-environment-read",
                "explicit-database-label"
              ]
            }
          }
        }
      }
    },
    "unclassified": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]+$" }
  }
}
