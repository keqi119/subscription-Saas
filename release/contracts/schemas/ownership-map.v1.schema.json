{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ownership-map.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mapId",
    "mapVersion",
    "sourceOwners",
    "targetOwnerProfile",
    "schemas",
    "objectClasses",
    "excludedExtensions"
  ],
  "properties": {
    "schemaVersion": { "const": "ownership-map.v1" },
    "mapId": { "$ref": "#/$defs/nonEmpty" },
    "mapVersion": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "sourceOwners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "targetOwnerProfile": { "const": "migrate" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "objectClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "schema",
          "table",
          "partitioned-table",
          "sequence",
          "view",
          "materialized-view",
          "function",
          "type"
        ]
      }
    },
    "excludedExtensions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
  }
}
