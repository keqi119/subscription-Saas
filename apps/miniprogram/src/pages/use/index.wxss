.current-car {
  margin-top: 36rpx;
}
.vehicle-name {
  font-size: 44rpx;
  font-weight: 600;
  margin: 34rpx 0 14rpx;
}
.section-gap {
  margin-top: 48rpx;
}
.service-tile {
  background: #ebeae4;
  text-align: left;
  padding: 30rpx;
  font-size: 30rpx;
  line-height: 1.6;
  border-radius: 8rpx;
  width: 100%;
}
.service-tile text {
  display: block;
}
.service-tile .muted {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.tile-number {
  font-size: 22rpx;
  color: #b44919;
  margin-bottom: 24rpx;
}
.menu-row {
  display: flex;
  justify-content: space-between;
  background: transparent;
  font-size: 30rpx;
  text-align: left;
  padding: 24rpx 0;
}
.todo + .todo {
  margin-top: 20rpx;
}

.page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.card {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.notice {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.row .section-title {
  margin-top: 0;
  margin-bottom: 0;
}
