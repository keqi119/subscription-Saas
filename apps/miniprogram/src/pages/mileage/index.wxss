.reading-input {
  font-size: 38rpx;
  font-variant-numeric: tabular-nums;
}
.attachment-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e1e0d9;
  gap: 20rpx;
  font-size: 26rpx;
}
.card .secondary,
.card .primary {
  margin-top: 28rpx;
}

.page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.card {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.notice {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}
.row .section-title {
  margin-top: 0;
  margin-bottom: 0;
}
