FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS deps

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/release-runner/package.json apps/release-runner/package.json
COPY packages/release-foundation/package.json packages/release-foundation/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile \
  --filter @subscription-saas/release-runner... \
  --filter @subscription-saas/api... \
  --filter @subscription-saas/shared...

FROM deps AS test-build

COPY apps/api ./apps/api
COPY packages/shared ./packages/shared
RUN pnpm --filter @subscription-saas/shared build \
  && pnpm --filter @subscription-saas/api prisma:generate

FROM postgres:17.11-bookworm@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0 AS runtime

ARG RUNNER_SOURCE_REVISION
ENV NODE_ENV=production
ENV PNPM_HOME="/pnpm"
ENV PATH="/pnpm:/usr/lib/postgresql/17/bin:$PATH"
WORKDIR /app

RUN test "${#RUNNER_SOURCE_REVISION}" -eq 40 \
  && printf '%s' "$RUNNER_SOURCE_REVISION" | grep -Eq '^[0-9a-f]{40}$'

LABEL org.opencontainers.image.revision="${RUNNER_SOURCE_REVISION}"

COPY --from=deps /usr/local/bin/node /usr/local/bin/node
COPY --from=deps /pnpm /pnpm
COPY --from=test-build /app/node_modules ./node_modules
COPY --from=test-build /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=test-build /app/apps/release-runner/node_modules ./apps/release-runner/node_modules
COPY --from=test-build /app/packages/release-foundation/node_modules ./packages/release-foundation/node_modules
COPY --from=test-build /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=test-build /app/packages/shared/dist ./packages/shared/dist
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api ./apps/api
COPY apps/release-runner ./apps/release-runner
COPY packages/release-foundation ./packages/release-foundation
COPY packages/shared ./packages/shared
COPY release ./release
COPY scripts ./scripts
COPY docs/runbooks ./docs/runbooks

RUN node --version \
  && psql --version \
  && ./apps/release-runner/node_modules/.bin/prisma --version \
  && test -f /app/apps/release-runner/src/cli.mjs \
  && sh -c 'cli_output="$(node /app/apps/release-runner/src/cli.mjs 2>&1)"; \
    cli_status="$?"; \
    cli_last_line="$(printf "%s\n" "$cli_output" | tail -n 1)"; \
    if test "$cli_status" -ne 1 || test "$cli_last_line" != "RUNNER_LAUNCH_ENVELOPE_REQUIRED"; then \
      printf "Runner negative check failed (status=%s):\n%s\n" "$cli_status" "$cli_output" >&2; \
      exit 1; \
    fi' \
  && sh -c 'cli_output="$(node /app/apps/release-runner/src/cli.mjs unsupported 2>&1)"; \
    cli_status="$?"; \
    cli_last_line="$(printf "%s\n" "$cli_output" | tail -n 1)"; \
    if test "$cli_status" -ne 1 || test "$cli_last_line" != "RUNNER_ENTRYPOINT_OVERRIDE_REJECTED"; then \
      printf "Runner override check failed (status=%s):\n%s\n" "$cli_status" "$cli_output" >&2; \
      exit 1; \
    fi'

ENTRYPOINT ["node", "/app/apps/release-runner/src/cli.mjs"]
