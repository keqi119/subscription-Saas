  "databaseTargetPolicyId": "s1-release-compose-ephemeral",
  "databaseTestManifest": "database-test-manifest.v1",
  "candidateIdentity": "build-proof.v1",
  "tls": "required",
  "hosted": {
    "repository": "keqi119/subscription-Saas",
    "repositoryId": "1253231368",
    "workflowRef": "refs/heads/main",
    "runAttempt": 1,
    "runnerClass": "github-hosted",
    "source": {
      "workflowPath": ".github/workflows/release-candidate-gate.yml",
      "environment": "trusted-source-database-gate",
