model User {
  id                                          String                          @id @default(uuid()) @db.Uuid
  username                                    String                          @unique @db.VarChar(64)
  name                                        String                          @db.VarChar(64)
  mobile                                      String?                         @db.VarChar(32)
  email                                       String?                         @unique @db.VarChar(128)
  passwordHash                                String                          @map("password_hash") @db.VarChar(255)
  status                                      UserStatus                      @default(ACTIVE)
  lastLoginAt                                 DateTime?                       @map("last_login_at") @db.Timestamptz(6)
  createdAt                                   DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                   DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                                   String?                         @map("created_by") @db.Uuid
  updatedBy                                   String?                         @map("updated_by") @db.Uuid
  deletedAt                                   DateTime?                       @map("deleted_at") @db.Timestamptz(6)
  roles                                       UserRole[]
  customers                                   Customer[]                      @relation("CustomerOwner")
  applications                                Application[]                   @relation("ApplicationSales")
  uploadedFiles                               FileObject[]                    @relation("FileUploader")
  followups                                   CustomerFollowup[]              @relation("FollowupUser")
  riskResults                                 RiskResult[]                    @relation("RiskResultApprover")
  reviewedMaterials                           ApplicationMaterial[]           @relation("MaterialReviewer")
  reviewedMaterialGroups                      ApplicationMaterialGroup[]      @relation("MaterialGroupReviewer")
  uploadedMaterialFiles                       ApplicationMaterialFile[]       @relation("MaterialFileUploader")
  deletedMaterialFiles                        ApplicationMaterialFile[]       @relation("MaterialFileDeleter")
  reviewedDeliveryEvidenceItems               VehicleDeliveryEvidenceItem[]   @relation("DeliveryEvidenceReviewer")
  uploadedDeliveryEvidenceFiles               VehicleDeliveryEvidenceFile[]   @relation("DeliveryEvidenceFileUploader")
  assignedHandoverWorkOrders                  VehicleHandoverWorkOrder[]      @relation("HandoverWorkOrderInternalOperator")
  opsReviewedHandoverWorkOrders               VehicleHandoverWorkOrder[]      @relation("HandoverWorkOrderOpsReviewer")
  acknowledgedHandoverReviewAttempts          VehicleHandoverReviewAttempt[]  @relation("HandoverReviewAttemptAdminAcknowledgedBy")
  resubmissionRequestedHandoverReviewAttempts VehicleHandoverReviewAttempt[]  @relation("HandoverReviewAttemptResubmissionRequestedBy")
  sentBackHandoverReviewAttempts              VehicleHandoverReviewAttempt[]  @relation("HandoverReviewAttemptSentBackBy")
  resolvedHandoverReviewAttempts              VehicleHandoverReviewAttempt[]  @relation("HandoverReviewAttemptResolvedBy")
  applicationActionLogs                       ApplicationActionLog[]          @relation("ApplicationActionOperator")
  approvedProductVersions                     ProductVersion[]                @relation("ProductVersionApprover")
  confirmedQuotes                             SubscriptionQuote[]             @relation("QuoteConfirmer")
  approvedContractVersions                    ContractVersion[]               @relation("ContractVersionApprover")
  approvedOrderChanges                        OrderChange[]                   @relation("OrderChangeApprover")
  approvedSubscriptionChanges                 SubscriptionChangeOrder[]       @relation("SubscriptionChangePriceOverrideApprover")
  takenOverSubscriptionChanges                SubscriptionChangeOrder[]       @relation("SubscriptionChangeManualTakeoverUser")
  confirmedMileageReadings                    VehicleMileageReading[]         @relation("VehicleMileageReadingConfirmer")
  voidedMileageReadings                       VehicleMileageReading[]         @relation("VehicleMileageReadingVoider")
  submittedMileageReviews                     OrderMileageReview[]            @relation("MileageReviewSubmittedByUser")
  reviewedMileageReviews                      OrderMileageReview[]            @relation("MileageReviewReviewedBy")
  voidedMileageReviews                        OrderMileageReview[]            @relation("MileageReviewVoidedBy")
  mileageReviewEvidence                       OrderMileageReviewEvidence[]    @relation("MileageReviewEvidenceUploadedByUser")
  createdAssetOwners                          AssetOwner[]                    @relation("AssetOwnerCreatedBy")
  updatedAssetOwners                          AssetOwner[]                    @relation("AssetOwnerUpdatedBy")
  createdVehicleOwnershipPeriods              VehicleOwnershipPeriod[]        @relation("VehicleOwnershipPeriodCreatedBy")
  startConfirmedVehicleOwnershipPeriods       VehicleOwnershipPeriod[]        @relation("VehicleOwnershipPeriodStartConfirmedBy")
  endConfirmedVehicleOwnershipPeriods         VehicleOwnershipPeriod[]        @relation("VehicleOwnershipPeriodEndConfirmedBy")
  createdVehicleSubscriptionPeriods           VehicleSubscriptionPeriod[]     @relation("VehicleSubscriptionPeriodCreatedBy")
  startConfirmedVehicleSubscriptionPeriods    VehicleSubscriptionPeriod[]     @relation("VehicleSubscriptionPeriodStartConfirmedBy")
  endConfirmedVehicleSubscriptionPeriods      VehicleSubscriptionPeriod[]     @relation("VehicleSubscriptionPeriodEndConfirmedBy")
  assignedAssetWorkOrders                     AssetWorkOrder[]                @relation("AssetWorkOrderAssignee")
  createdAssetWorkOrders                      AssetWorkOrder[]                @relation("AssetWorkOrderCreatedBy")
  updatedAssetWorkOrders                      AssetWorkOrder[]                @relation("AssetWorkOrderUpdatedBy")
  assetWorkOrderEvents                        AssetWorkOrderEvent[]           @relation("AssetWorkOrderEventActor")
  assetWorkOrderEvidence                      AssetWorkOrderEvidence[]        @relation("AssetWorkOrderEvidenceActor")
  releasedVehicleOperationalRestrictions      VehicleOperationalRestriction[] @relation("VehicleOperationalRestrictionReleasedBy")
  createdVehicleOperationalRestrictions       VehicleOperationalRestriction[] @relation("VehicleOperationalRestrictionCreatedBy")
  updatedVehicleOperationalRestrictions       VehicleOperationalRestriction[] @relation("VehicleOperationalRestrictionUpdatedBy")
  confirmedVehicleCostLedgerEntries           VehicleCostLedgerEntry[]        @relation("VehicleCostLedgerEntryConfirmedBy")
  requestedBusinessExceptionApprovals         BusinessExceptionApproval[]     @relation("BusinessExceptionApprovalRequestedBy")
  decidedBusinessExceptionApprovals           BusinessExceptionApproval[]     @relation("BusinessExceptionApprovalDecidedBy")
  expiredBusinessExceptionApprovals           BusinessExceptionApproval[]     @relation("BusinessExceptionApprovalExpiredBy")
  assetAccountingCommandReceipts              AssetAccountingCommandReceipt[] @relation("AssetAccountingCommandReceiptActor")
  createdSubscriptionClosureCases             SubscriptionClosureCase[] @relation("SubscriptionClosureCaseCreatedBy")
  updatedSubscriptionClosureCases             SubscriptionClosureCase[] @relation("SubscriptionClosureCaseUpdatedBy")
  subscriptionClosureEvents                   SubscriptionClosureEvent[] @relation("SubscriptionClosureEventActor")
  generatedSubscriptionClosureDocuments       SubscriptionClosureDocumentRevision[] @relation("SubscriptionClosureDocumentGeneratedBy")
  signedSubscriptionClosureDocuments          SubscriptionClosureDocumentRevision[] @relation("SubscriptionClosureDocumentSignedBy")
  archivedSubscriptionClosureDocuments        SubscriptionClosureDocumentRevision[] @relation("SubscriptionClosureDocumentArchivedBy")
  updatedSubscriptionClosureCurrentDocuments  SubscriptionClosureCurrentDocument[] @relation("SubscriptionClosureCurrentDocumentUpdatedBy")
  createdSubscriptionClosureSettlements       SubscriptionClosureSettlementRevision[] @relation("SubscriptionClosureSettlementCreatedBy")
  finalizedSubscriptionClosureSettlements     SubscriptionClosureSettlementRevision[] @relation("SubscriptionClosureSettlementFinalizedBy")
  settledSubscriptionClosureSettlements       SubscriptionClosureSettlementRevision[] @relation("SubscriptionClosureSettlementSettledBy")
  subscriptionClosureCommandReceipts          SubscriptionClosureCommandReceipt[] @relation("SubscriptionClosureCommandReceiptActor")

  @@index([status])
  @@map("user")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  name        String           @db.VarChar(64)
  description String?          @db.Text
  status      RecordStatus     @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]
  menus       RoleMenu[]

  @@index([status])
  @@map("role")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(128)
  name        String           @db.VarChar(128)
  module      String           @db.VarChar(64)
  action      String           @db.VarChar(64)
  description String?          @db.Text
  status      RecordStatus     @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@index([module])
  @@index([status])
  @@map("permission")
}

model Menu {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique @db.VarChar(128)
  name           String       @db.VarChar(128)
  path           String       @db.VarChar(255)
  icon           String?      @db.VarChar(64)
  sortOrder      Int          @default(0) @map("sort_order")
  permissionCode String?      @map("permission_code") @db.VarChar(128)
  parentId       String?      @map("parent_id") @db.Uuid
  parent         Menu?        @relation("MenuTree", fields: [parentId], references: [id])
  children       Menu[]       @relation("MenuTree")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  roles          RoleMenu[]

  @@index([parentId])
  @@index([status])
  @@map("menu")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model RoleMenu {
  id        String    @id @default(uuid()) @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  menuId    String    @map("menu_id") @db.Uuid
  role      Role      @relation(fields: [roleId], references: [id])
  menu      Menu      @relation(fields: [menuId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([roleId, menuId])
  @@index([menuId])
  @@map("role_menu")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  module         String      @db.VarChar(64)
  entityType     String      @map("entity_type") @db.VarChar(64)
  entityId       String?     @map("entity_id") @db.Uuid
  action         AuditAction
  beforeSnapshot Json?       @map("before_snapshot")
  afterSnapshot  Json?       @map("after_snapshot")
  operatorId     String?     @map("operator_id") @db.Uuid
  ipAddress      String?     @map("ip_address") @db.VarChar(64)
  userAgent      String?     @map("user_agent") @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([module])
  @@index([entityType, entityId])
  @@index([operatorId])
  @@index([createdAt])
  @@map("audit_log")
}

model Customer {
  id                      String                         @id @default(uuid()) @db.Uuid
  customerNo              String                         @unique @map("customer_no") @db.VarChar(64)
  name                    String                         @db.VarChar(64)
  mobile                  String                         @db.VarChar(32)
  customerType            CustomerType                   @default(PERSONAL) @map("customer_type")
  sourceChannel           String?                        @map("source_channel") @db.VarChar(64)
  grade                   CustomerGrade?
  riskScore               Int?                           @map("risk_score")
  status                  CustomerStatus                 @default(LEAD)
  ownerUserId             String?                        @map("owner_user_id") @db.Uuid
  ownerUser               User?                          @relation("CustomerOwner", fields: [ownerUserId], references: [id])
  remark                  String?                        @db.Text
  accounts                CustomerAccount[]
  identity                CustomerIdentity?
  profile                 CustomerProfile?
  profileMaterials        CustomerProfileMaterial[]
  followups               CustomerFollowup[]
  applications            Application[]
  riskResults             RiskResult[]
  quotes                  SubscriptionQuote[]
  orders                  SubscriptionOrder[]
  contracts               Contract[]
  deliveries              VehicleDelivery[]
  returns                 VehicleReturn[]
  receivableBills         ReceivableBill[]
  paymentRecords          PaymentRecord[]
  paymentOrders           PaymentOrder[]
  paymentMandates         PaymentMandate[]
  debitAttempts           DebitAttempt[]
  paymentWriteOffs        PaymentWriteOff[]
  depositLedgers          DepositLedger[]
  collectionCases         CollectionCase[]
  collectionCaseBills     CollectionCaseBill[]
  collectionActions       CollectionAction[]
  serviceCases            ServiceCase[]
  notificationRecords     NotificationRecord[]
  notificationEvents      NotificationEvent[]
  entitlementAccounts     OrderEntitlementAccount[]
  entitlementGrants       OrderEntitlementGrant[]
  entitlementUsages       OrderEntitlementUsage[]
  submittedMileageReviews OrderMileageReview[]           @relation("MileageReviewSubmittedByCustomer")
  mileageReviewEvidence   OrderMileageReviewEvidence[]   @relation("MileageReviewEvidenceUploadedByCustomer")
  esignProviderAccounts   CustomerESignProviderAccount[]
  insuranceClaims         InsuranceClaim[]
  subscriptionPeriods     VehicleSubscriptionPeriod[]
  assetWorkOrders         AssetWorkOrder[]
  costLedgerEntries       VehicleCostLedgerEntry[]
  closureCases            SubscriptionClosureCase[]
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy               String?                        @map("created_by") @db.Uuid
  updatedBy               String?                        @map("updated_by") @db.Uuid
  deletedAt               DateTime?                      @map("deleted_at") @db.Timestamptz(6)

  @@index([mobile])
  @@index([ownerUserId])
  @@index([status])
  @@map("customer")
}

model CustomerAccount {
  id              String                @id @default(uuid()) @db.Uuid
  customerId      String                @map("customer_id") @db.Uuid
  customer        Customer              @relation(fields: [customerId], references: [id])
  phone           String                @unique @db.VarChar(32)
  phoneVerifiedAt DateTime?             @map("phone_verified_at") @db.Timestamptz(6)
  wechatOpenId    String?               @map("wechat_open_id") @db.VarChar(128)
  wechatUnionId   String?               @map("wechat_union_id") @db.VarChar(128)
  accountStatus   CustomerAccountStatus @default(ACTIVE) @map("account_status")
  lastLoginAt     DateTime?             @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp     String?               @map("last_login_ip") @db.VarChar(64)
  lastUserAgent   String?               @map("last_user_agent") @db.VarChar(255)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?               @map("created_by") @db.Uuid
  updatedBy       String?               @map("updated_by") @db.Uuid
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(6)

  @@index([customerId])
  @@index([phone])
  @@index([wechatOpenId])
  @@index([wechatUnionId])
  @@index([accountStatus])
  @@map("customer_account")
}

model CustomerESignProviderAccount {
  id                            String                            @id @default(uuid()) @db.Uuid
  customerId                    String                            @map("customer_id") @db.Uuid
  customer                      Customer                          @relation(fields: [customerId], references: [id])
  provider                      ESignProviderType
  accountType                   ESignProviderAccountType          @default(PERSONAL) @map("account_type")
  source                        ESignProviderAccountSource        @default(SYSTEM_REGISTER)
  providerOpenId                String                            @map("provider_open_id") @db.VarChar(96)
  providerCustomerId            String?                           @map("provider_customer_id") @db.VarChar(128)
  registrationStatus            ESignProviderAccountStatus        @default(PENDING) @map("registration_status")
  realNameStatus                ESignRealNameStatus               @default(UNVERIFIED) @map("real_name_status")
  verificationSerialNo          String?                           @map("verification_serial_no") @db.VarChar(128)
  verificationTransactionNo     String?                           @map("verification_transaction_no") @db.VarChar(128)
  verifiedAt                    DateTime?                         @map("verified_at") @db.Timestamptz(6)
  realNameProviderStatus        String?                           @map("real_name_provider_status") @db.VarChar(32)
  realNameProviderStatusSource  ESignProviderRealNameStatusSource @default(UNKNOWN) @map("real_name_provider_status_source")
  realNameProviderVerifiedAt    DateTime?                         @map("real_name_provider_verified_at") @db.Timestamptz(6)
  certBindingStatus             ESignProviderCertBindingStatus    @default(UNKNOWN) @map("cert_binding_status")
  certBindingSource             ESignProviderCertBindingSource    @default(UNKNOWN) @map("cert_binding_source")
  certBoundAt                   DateTime?                         @map("cert_bound_at") @db.Timestamptz(6)
  certSerialNo                  String?                           @map("cert_serial_no") @db.VarChar(128)
  providerStatusLastRefreshedAt DateTime?                         @map("provider_status_last_refreshed_at") @db.Timestamptz(6)
  readinessBlockingCode         String?                           @map("readiness_blocking_code") @db.VarChar(128)
  readinessBlockingReason       String?                           @map("readiness_blocking_reason") @db.Text
  lastErrorCode                 String?                           @map("last_error_code") @db.VarChar(128)
  lastErrorMessage              String?                           @map("last_error_message") @db.Text
  providerSnapshot              Json?                             @map("provider_snapshot")
  createdAt                     DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                     String?                           @map("created_by") @db.Uuid
  updatedBy                     String?                           @map("updated_by") @db.Uuid
  deletedAt                     DateTime?                         @map("deleted_at") @db.Timestamptz(6)

  @@unique([provider, customerId, accountType])
  @@unique([provider, providerOpenId])
  @@unique([provider, providerCustomerId])
  @@index([customerId])
  @@index([provider])
  @@index([registrationStatus])
  @@index([realNameStatus])
  @@index([certBindingStatus])
  @@index([providerStatusLastRefreshedAt])
  @@map("customer_esign_provider_account")
}

