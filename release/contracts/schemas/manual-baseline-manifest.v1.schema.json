{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manual-baseline-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "createdAt", "promotionEligible"],
  "properties": {
    "schemaVersion": {
      "const": "manual-baseline-manifest.v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildProofDigest",
        "purpose",
        "targetObservationDigest",
        "physicalIdentity",
        "roleObservation",
        "preStateDigest",
        "authorizationDigest"
      ],
      "properties": {
        "buildProofDigest": {
          "$ref": "#/$defs/digest"
        },
        "purpose": {
          "enum": ["synthetic-fresh", "staging-mainline"]
        },
        "targetObservationDigest": {
          "$ref": "#/$defs/digest"
        },
        "physicalIdentity": {
          "$ref": "#/$defs/physicalIdentity"
        },
        "roleObservation": {
          "$ref": "#/$defs/roleObservation"
        },
        "preStateDigest": {
          "$ref": "#/$defs/digest"
        },
        "authorizationDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "promotionEligible": {
      "const": false
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targetIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpointPolicyId", "databaseName"],
      "properties": {
        "endpointPolicyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "databaseName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "physicalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpointPolicyId", "databaseName", "databaseOid", "clusterFingerprint"],
      "properties": {
        "endpointPolicyId": {
          "$ref": "#/$defs/label"
        },
        "databaseName": {
          "$ref": "#/$defs/label"
        },
        "databaseOid": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "clusterFingerprint": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "roleObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "tls", "schemaObservationDigest"],
      "properties": {
        "role": {
          "$ref": "#/$defs/label"
        },
        "tls": {
          "const": true
        },
        "schemaObservationDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "error": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "report": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "domainInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseIdentityFingerprint",
        "baselineManifestIdentityDigest",
        "baselineManifestDigest",
        "expectedSchemaDigest",
        "expectedOwner",
        "allowedExtensions"
      ],
      "properties": {
        "databaseIdentityFingerprint": {
          "$ref": "#/$defs/digest"
        },
        "baselineManifestIdentityDigest": {
          "$ref": "#/$defs/digest"
        },
        "baselineManifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectedSchemaDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectedOwner": {
          "$ref": "#/$defs/label"
        },
        "allowedExtensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
