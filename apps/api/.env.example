# API runtime
NODE_ENV=development
PORT=3001
API_PORT=3001

# Database
DATABASE_URL=postgresql://subscription:subscription@localhost:5432/subscription_saas?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
REDIS_URL=redis://localhost:6379

# Auth and CORS
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-long-random-secret-if-signed-cookies-are-enabled
CORS_ORIGIN=http://localhost:3000

# API limits and local storage
API_JSON_BODY_LIMIT=5mb
LOCAL_FILE_STORAGE_DIR=./uploads

# Seed and smoke
SEED_ADMIN_PASSWORD=Admin@123456
SMOKE_API_BASE_URL=http://localhost:3001/api
SMOKE_ADMIN_USERNAME=admin
SMOKE_ADMIN_PASSWORD=Admin@123456
