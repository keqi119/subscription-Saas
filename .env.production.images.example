# Stage 9F-D image-based production deployment environment.
# Copy to .env.production.images on the production server. Do not commit real secrets.
# This env is for pull/up with prebuilt images; it is not used for server-side build.

NODE_ENV=production
APP_ENV=production

# Replace these with immutable production registry tags. Do not use latest.
# Example shape: <REGISTRY>/<NAMESPACE>/subscription-api:prod-YYYYMMDD-<shortSha>
API_IMAGE=registry.example.com/example/subscription-api:prod-20260615-abcdef0
WEB_IMAGE=registry.example.com/example/subscription-web:prod-20260615-abcdef0

# Production domains
ADMIN_DOMAIN=admin.subauto.keybox.cloud
API_DOMAIN=api.subauto.keybox.cloud

# PostgreSQL container bootstrap
POSTGRES_DB=subscription_saas_prod
POSTGRES_USER=subscription_saas
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Application database URL
DATABASE_URL=postgresql://subscription_saas:<CHANGE_ME_STRONG_PASSWORD>@postgres:5432/subscription_saas_prod?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# Auth and browser access
JWT_SECRET=<CHANGE_ME_64_CHARS>
JWT_EXPIRES_IN=7d
COOKIE_SECRET=<CHANGE_ME_64_CHARS>
CORS_ORIGIN=https://admin.subauto.keybox.cloud,https://app.subauto.keybox.cloud
CUSTOMER_JWT_SECRET=<CHANGE_ME_64_CHARS_CUSTOMER>
CUSTOMER_ACCESS_TOKEN_COOKIE=customer_access_token
CUSTOMER_ACCESS_TOKEN_EXPIRES_IN=7d
PORTAL_OTP_TTL_SECONDS=300
PORTAL_OTP_RESEND_SECONDS=60
PORTAL_OTP_MAX_ATTEMPTS=5
PORTAL_AUTH_DEBUG_CODE=false
PORTAL_SMS_PROVIDER=aliyun
PORTAL_SMS_ENABLED=true
PORTAL_SMS_DEBUG_CODE=false
PORTAL_BETA_MODE=true
PORTAL_BETA_ALLOWED_PHONES=<CHANGE_ME_COMMA_SEPARATED>
ALIYUN_SMS_ACCESS_KEY_ID=<CHANGE_ME>
ALIYUN_SMS_ACCESS_KEY_SECRET=<CHANGE_ME>
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=<CHANGE_ME>
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=<CHANGE_ME>
ALIYUN_SMS_TEMPLATE_CODE_VARIABLE=code
PORTAL_CORS_ORIGIN=https://app.subauto.keybox.cloud

# E-sign provider abstraction. Keep mock disabled for production unless running a controlled test.
ESIGN_PROVIDER=mock
ESIGN_MOCK_ENABLED=false
ESIGN_SIGN_URL_EXPIRES_SECONDS=1800
ESIGN_CALLBACK_SECRET=<CHANGE_ME_64_CHARS_ESIGN_CALLBACK>
PORTAL_BASE_URL=https://app.subauto.keybox.cloud
API_BASE_URL=https://api.subauto.keybox.cloud/api

# Payment provider abstraction. Keep mock disabled for production unless running a controlled test.
PAYMENT_PROVIDER=wechat_pay
PAYMENT_MOCK_ENABLED=false
PAYMENT_DEFAULT_CHANNEL=WECHAT_JSAPI
PAYMENT_CASHIER_URL_EXPIRES_SECONDS=1800
PAYMENT_CALLBACK_SECRET=<CHANGE_ME_64_CHARS_PAYMENT_CALLBACK>

WECHAT_PAY_ENABLED=true
WECHAT_PAY_MODE=direct
WECHAT_PAY_DEFAULT_CHANNEL=WECHAT_JSAPI
WECHAT_PAY_MCH_ID=<CHANGE_ME>
WECHAT_PAY_APP_ID=<CHANGE_ME>
WECHAT_PAY_APP_SECRET=<CHANGE_ME>
WECHAT_PAY_API_V3_KEY=<CHANGE_ME_32_CHARS>
WECHAT_PAY_MERCHANT_SERIAL_NO=<CHANGE_ME>
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=/opt/subscription-saas/secrets/wechatpay/apiclient_key.pem
WECHAT_PAY_MERCHANT_CERT_PATH=/opt/subscription-saas/secrets/wechatpay/apiclient_cert.pem
WECHAT_PAY_PUBLIC_KEY_ID=<CHANGE_ME_IF_USING_PUBLIC_KEY>
WECHAT_PAY_PUBLIC_KEY_PATH=/opt/subscription-saas/secrets/wechatpay/wechatpay_public_key.pem
WECHAT_PAY_PLATFORM_CERT_PATH=/opt/subscription-saas/secrets/wechatpay/wechatpay_platform_cert.pem
# Recommended during WeChat Pay platform certificate rotation:
# serial:/absolute/path/to/cert.pem,serial2:/absolute/path/to/cert2.pem
WECHAT_PAY_PLATFORM_CERTS=<OLD_SERIAL>:/opt/subscription-saas/secrets/wechatpay/platform-certs/old.pem,<NEW_SERIAL>:/opt/subscription-saas/secrets/wechatpay/platform-certs/new.pem
WECHAT_PAY_NOTIFY_URL=https://api.subauto.keybox.cloud/api/payments/callback/wechat-pay
WECHAT_PAY_JSAPI_AUTH_DIR=https://app.subauto.keybox.cloud/
WECHAT_PAY_OAUTH_REDIRECT_URI=https://api.subauto.keybox.cloud/api/portal/wechat/oauth/callback
WECHAT_OAUTH_STATE_TTL_SECONDS=300
WECHAT_OAUTH_MOCK_ENABLED=false

# Notification center. Keep real WeChat sends disabled until Stage 10H-B validation.
NOTIFICATION_PROVIDER=mock
NOTIFICATION_WECHAT_ENABLED=false
WECHAT_OFFICIAL_ACCOUNT_APP_ID=<CHANGE_ME>
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=<CHANGE_ME>
WECHAT_OFFICIAL_ACCOUNT_TOKEN_CACHE_SECONDS=7000
WECHAT_TEMPLATE_APPLICATION_PROGRESS=<CHANGE_ME>
WECHAT_TEMPLATE_FINAL_PLAN_PENDING=<CHANGE_ME>
WECHAT_TEMPLATE_CONTRACT_PENDING=<CHANGE_ME>
WECHAT_TEMPLATE_PAYMENT_PENDING=<CHANGE_ME>
WECHAT_TEMPLATE_SERVICE_CASE_UPDATE=<CHANGE_ME>
WECHAT_OA_SMOKE_MODE=token
WECHAT_OA_TEST_OPENID=<CHANGE_ME>
WECHAT_OA_TEST_CUSTOMER_NO=stage10_wechat_notify_test_customer
WECHAT_OA_TEST_PHONE=13900001010
WECHAT_OA_TEMPLATE_TYPE=PAYMENT_PENDING
WECHAT_OA_TEMPLATE_DATA_JSON=
WECHAT_OA_BIND_OPENID=0
WECHAT_OA_CREATE_TEST_CUSTOMER=0
WECHAT_OA_SYNC_TEMPLATE_ID=0
STAGE10H_ALLOW_BATCH_SEND=0
WECHAT_MENU_APPLY=0
WECHAT_MENU_RESULT_PATH=.tmp/stage10h-wechat-menu-apply-result.json

# Container ports and localhost-only host ports for BT/Nginx reverse proxy.
PORT=3001
API_PORT=3001
WEB_PORT=3000
API_HOST_PORT=3001
WEB_HOST_PORT=3000

# Web image must already be built with this public API endpoint.
NEXT_PUBLIC_API_BASE_URL=https://api.subauto.keybox.cloud/api

# Production uploads should use OSS. Keep local uploads as a working directory only.
UPLOAD_STORAGE_DRIVER=oss
UPLOAD_LOCAL_DIR=/app/uploads
LOCAL_FILE_STORAGE_DIR=/app/uploads

# Aliyun OSS. Do not commit real values.
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=<CHANGE_ME>
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=<CHANGE_ME>
OSS_ACCESS_KEY_SECRET=<CHANGE_ME>
OSS_PREFIX=subscription-saas/production
OSS_INTERNAL_ENDPOINT=
OSS_SIGNED_URL_EXPIRES_SECONDS=300

# API limits
API_JSON_BODY_LIMIT=5mb

# Baseline seed
SEED_ADMIN_PASSWORD=<CHANGE_ME_INITIAL_ADMIN_PASSWORD>

# Production smoke checks
SMOKE_API_BASE_URL=https://api.subauto.keybox.cloud/api
SMOKE_WEB_BASE_URL=https://admin.subauto.keybox.cloud
SMOKE_ADMIN_USERNAME=admin
SMOKE_ADMIN_PASSWORD=<CHANGE_ME_INITIAL_ADMIN_PASSWORD>
