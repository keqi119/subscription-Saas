  batchNo       String                          @unique @map("batch_no") @db.VarChar(64)
  source        MarketPriceSource
  fileName      String?                         @map("file_name") @db.VarChar(255)
  importedBy    String?                         @map("imported_by") @db.Uuid
  totalRows     Int                             @default(0) @map("total_rows")
  importedRows  Int                             @default(0) @map("imported_rows")
  skippedRows   Int                             @default(0) @map("skipped_rows")
  failedRows    Int                             @default(0) @map("failed_rows")
  importStatus  MarketPriceImportStatus         @default(COMPLETED) @map("import_status")
  remark        String?                         @db.Text
  errorSnapshot Json?                           @map("error_snapshot")
  snapshot      Json?
  observations  VehicleMarketPriceObservation[]
  createdAt     DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?                       @map("deleted_at") @db.Timestamptz(6)

  @@index([source])
  @@index([importStatus])
  @@index([createdAt])
  @@map("market_price_import_batch")
}

