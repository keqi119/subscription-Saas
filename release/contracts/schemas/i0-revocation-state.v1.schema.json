{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "i0-revocation-state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyDigest",
    "sequence",
    "revokedAuthorizationIds",
    "revokedAuthorizationDigests"
  ],
  "properties": {
    "schemaVersion": { "const": "i0-revocation-state.v1" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "revokedAuthorizationIds": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "revokedAuthorizationDigests": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
