{
  "name": "subscription-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @subscription-saas/api --filter @subscription-saas/web dev",
    "dev:api": "pnpm --filter @subscription-saas/api dev",
    "dev:web": "pnpm --filter @subscription-saas/web dev",
    "api:smoke": "node scripts/api-smoke.mjs",
    "smoke:api": "node scripts/api-smoke.mjs",
    "smoke:mainline": "node scripts/api-smoke.mjs --scenario mainline",
    "smoke:residual": "node scripts/api-smoke.mjs --scenario residual",
    "smoke:upload": "node scripts/upload-storage-smoke.mjs",
    "smoke": "node scripts/api-smoke.mjs",
    "portal:route-smoke": "node scripts/portal-route-smoke.mjs",
    "portal:api-smoke": "node scripts/portal-api-smoke.mjs",
    "filename-repair:dry-run": "node scripts/repair-upload-filenames.mjs --dry-run",
    "filename-repair:apply": "node scripts/repair-upload-filenames.mjs --apply",
    "filename-repair:test": "node --test scripts/repair-upload-filenames.test.mjs",
    "subscription-segments:bootstrap:dry-run": "node scripts/subscription-segment-bootstrap.mjs --dry-run",
    "subscription-segments:bootstrap:apply": "node scripts/subscription-segment-bootstrap.mjs --apply",
    "subscription-renewals:reconcile": "node scripts/subscription-renewal-reconcile.mjs",
    "subscription-extension:smoke": "node scripts/subscription-extension-smoke.mjs",
    "wechat-pay:download-platform-certs": "node scripts/wechat-pay-download-platform-certs.mjs",
    "wechat:menu:dry-run": "node scripts/wechat-menu.mjs --dry-run",
    "wechat:menu:apply": "node scripts/wechat-menu.mjs --apply",
    "wechat:oa:smoke": "node scripts/wechat-official-account-smoke.mjs",
    "fadada:sandbox-upload-signurl-smoke": "node scripts/fadada-sandbox-upload-signurl-smoke.mjs",
    "fadada:sandbox-upload-signurl-smoke:test": "node --test scripts/fadada-sandbox-upload-signurl-smoke.test.mjs",
    "fadada:upload-signurl:preflight": "node scripts/fadada-production-upload-signurl-smoke.mjs --mode preflight",
    "fadada:upload-signurl:run": "node scripts/fadada-production-upload-signurl-smoke.mjs --mode run",
    "fadada:upload-signurl:signurl-only": "node scripts/fadada-production-upload-signurl-smoke.mjs --mode signurl-only",
    "fadada:upload-signurl:test": "node --test scripts/fadada-production-upload-signurl-smoke.test.mjs",
    "fadada:test-signer:preflight": "node scripts/fadada-production-test-signer-realname.mjs --mode preflight",
    "fadada:test-signer:prepare": "node scripts/fadada-production-test-signer-realname.mjs --mode prepare",
    "fadada:test-signer:status": "node scripts/fadada-production-test-signer-realname.mjs --mode status",
    "fadada:production-test-signer-realname": "node scripts/fadada-production-test-signer-realname.mjs --mode preflight",
    "fadada:production-test-signer-realname:test": "node --test scripts/fadada-production-test-signer-realname.test.mjs",
    "stage1:golden-path:preflight": "node scripts/stage1-golden-path-production-preflight.mjs",
    "stage1:golden-path:preflight:test": "node --test scripts/stage1-golden-path-production-preflight.test.mjs",
    "stage1:auto-debit-retirement:dry-run": "node scripts/stage1-auto-debit-retirement.mjs --dry-run",
    "stage1:auto-debit-retirement:apply": "node scripts/stage1-auto-debit-retirement.mjs --apply",
    "stage1:auto-debit-retirement:test": "node --test scripts/stage1-auto-debit-retirement-core.test.mjs scripts/stage1-auto-debit-retirement-executor.test.mjs",
    "stage1c:periods:dry-run": "node scripts/stage1c-period-backfill.mjs --dry-run",
    "stage1c:periods:apply": "node scripts/stage1c-period-backfill.mjs --apply",
    "stage2-handover-workflow:backfill:dry-run": "node scripts/stage2-handover-workflow-backfill.mjs --dry-run",
    "stage2-handover-workflow:backfill:apply": "node scripts/stage2-handover-workflow-backfill.mjs --apply",
    "stage2-handover-workflow:backfill:test": "node --test scripts/stage2-handover-workflow-backfill-core.test.mjs scripts/stage2-handover-workflow-backfill-apply.test.mjs scripts/stage2-handover-workflow-backfill-executor.test.mjs",
    "vehicle-model:enum-freeze": "node scripts/check-vehicle-model-enum-freeze.mjs",
    "vehicle-model:enum-freeze:test": "node --test scripts/check-vehicle-model-enum-freeze.test.mjs",
    "vehicle-model:contract-governance": "node scripts/vehicle-model-contract-governance.mjs",
    "vehicle-model:removal-readiness": "node scripts/vehicle-model-removal-readiness.mjs",
    "vehicle-model:removal-readiness:test": "node --test scripts/vehicle-model-removal-readiness-core.test.mjs",
    "quality:gate": "pnpm -r lint && pnpm prisma:validate && pnpm prisma:generate && pnpm --filter @subscription-saas/api typecheck && pnpm --filter @subscription-saas/web typecheck && pnpm --filter @subscription-saas/api test && pnpm prisma:migrate:status",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @subscription-saas/api prisma:generate",
    "prisma:migrate": "pnpm --filter @subscription-saas/api prisma:migrate",
    "prisma:migrate:deploy": "pnpm --filter @subscription-saas/api prisma:migrate:deploy",
    "prisma:migrate:status": "pnpm --filter @subscription-saas/api prisma:migrate:status",
    "prisma:seed": "pnpm --filter @subscription-saas/api prisma:seed",
    "prisma:seed:verify": "pnpm --filter @subscription-saas/api prisma:seed:verify",
    "prisma:validate": "pnpm --filter @subscription-saas/api prisma:validate",
    "release:check": "node scripts/release-check.mjs",
    "seed:scenario": "pnpm --filter @subscription-saas/api exec node prisma/seed-scenario.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
