{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-change-approval.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "subject",
    "subjectDigest",
    "target",
    "planDigest",
    "expectedPreStateDigest",
    "approver",
    "issuedAt",
    "notAfter",
    "revocationPolicyDigest",
    "custodyReference",
    "protected"
  ],
  "properties": {
    "schemaVersion": { "const": "external-change-approval.v1" },
    "operationId": { "type": "string", "minLength": 1 },
    "subjectDigest": { "$ref": "#/$defs/digest" },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["infrastructureChangeId"],
          "properties": {
            "infrastructureChangeId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseAttemptId"],
          "properties": { "releaseAttemptId": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceKind", "resourceId"],
      "properties": {
        "resourceKind": {
          "enum": [
            "oidc-provider",
            "role-trust-policy",
            "role-permission-policy",
            "environment-policy",
            "repository-subject"
          ]
        },
        "resourceId": { "type": "string", "minLength": 1 }
      }
    },
    "planDigest": { "$ref": "#/$defs/digest" },
    "expectedPreStateDigest": { "$ref": "#/$defs/digest" },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutableId"],
      "properties": { "immutableId": { "type": "string", "minLength": 1 } }
    },
    "issuedAt": { "$ref": "#/$defs/timestamp" },
    "notAfter": { "$ref": "#/$defs/timestamp" },
    "revocationPolicyDigest": { "$ref": "#/$defs/digest" },
    "custodyReference": { "type": "string", "minLength": 1 },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "keyId", "algorithm", "signature"],
      "properties": {
        "issuer": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 },
        "algorithm": { "const": "Ed25519" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "rfc3339Finite": true,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"
    }
  }
}
